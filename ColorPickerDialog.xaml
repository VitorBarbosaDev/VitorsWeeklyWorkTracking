<Window x:Class="VitorsWeeklyWorkTracking.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎨 Color Picker"
        Width="440"
        Height="520"
        MinWidth="400"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.Foreground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="PickerTitleBlock" Text="🎨 Select Color" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}"/>
                <TextBlock Text="Pick from the spectrum, adjust hue, enter HEX, or choose a preset" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 2 0 0"/>
            </StackPanel>
            
            <!-- Live Preview Card -->
            <Border Grid.Column="1"
                    Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6 4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0 0 8 0" VerticalAlignment="Center">
                        <TextBlock Text="NEW" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                        <Border x:Name="NewColorPreview" Width="36" Height="24" CornerRadius="4" Background="#6B7280" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" Margin="0 2 0 0"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OLD" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                        <Border x:Name="OldColorPreview" Width="36" Height="24" CornerRadius="4" Background="#6B7280" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" Margin="0 2 0 0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Color Picker Controls Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14 12">
            <StackPanel>
                <!-- Saturation / Value 2D Gradient Canvas -->
                <Border Height="160" CornerRadius="6" ClipToBounds="True" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1">
                    <Canvas x:Name="SatValCanvas"
                            Height="160"
                            HorizontalAlignment="Stretch"
                            Background="Red"
                            MouseDown="SatValCanvas_MouseDown"
                            MouseMove="SatValCanvas_MouseMove"
                            MouseUp="SatValCanvas_MouseUp"
                            Cursor="Cross">
                        <!-- Horizontal white-to-transparent overlay (Saturation) -->
                        <Rectangle Width="{Binding ActualWidth, ElementName=SatValCanvas}"
                                   Height="{Binding ActualHeight, ElementName=SatValCanvas}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Vertical transparent-to-black overlay (Value/Brightness) -->
                        <Rectangle Width="{Binding ActualWidth, ElementName=SatValCanvas}"
                                   Height="{Binding ActualHeight, ElementName=SatValCanvas}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Selector Handle -->
                        <Ellipse x:Name="CrosshairHandle"
                                 Width="14"
                                 Height="14"
                                 Stroke="#FFFFFFFF"
                                 StrokeThickness="2"
                                 Fill="#33000000"
                                 IsHitTestVisible="False"
                                 Canvas.Left="0"
                                 Canvas.Top="0"/>
                    </Canvas>
                </Border>

                <!-- Hue Slider -->
                <Grid Margin="0 10 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Hue Spectrum (0° – 360°)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 3"/>
                    <Slider x:Name="HueSlider"
                            Grid.Row="1"
                            Minimum="0"
                            Maximum="360"
                            Value="0"
                            Height="24"
                            ValueChanged="HueSlider_ValueChanged">
                        <Slider.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFF0000" Offset="0.00"/>
                                <GradientStop Color="#FFFFFF00" Offset="0.17"/>
                                <GradientStop Color="#FF00FF00" Offset="0.33"/>
                                <GradientStop Color="#FF00FFFF" Offset="0.50"/>
                                <GradientStop Color="#FF0000FF" Offset="0.67"/>
                                <GradientStop Color="#FFFF00FF" Offset="0.83"/>
                                <GradientStop Color="#FFFF0000" Offset="1.00"/>
                            </LinearGradientBrush>
                        </Slider.Background>
                    </Slider>
                </Grid>

                <!-- HEX & RGB Inputs -->
                <Grid Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hex Input -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="HEX Code" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 2"/>
                        <TextBox x:Name="HexInputTextBox"
                                 Height="28"
                                 FontFamily="Consolas, monospace"
                                 FontWeight="Bold"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Padding="6 2"
                                 TextChanged="HexInputTextBox_TextChanged"/>
                    </StackPanel>

                    <!-- R Input -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="R (0-255)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 2"/>
                        <TextBox x:Name="RedInputTextBox"
                                 Height="28"
                                 FontFamily="Consolas, monospace"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Padding="4 2"
                                 TextAlignment="Center"
                                 TextChanged="RgbInputTextBox_TextChanged"/>
                    </StackPanel>

                    <!-- G Input -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="G (0-255)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 2"/>
                        <TextBox x:Name="GreenInputTextBox"
                                 Height="28"
                                 FontFamily="Consolas, monospace"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Padding="4 2"
                                 TextAlignment="Center"
                                 TextChanged="RgbInputTextBox_TextChanged"/>
                    </StackPanel>

                    <!-- B Input -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="B (0-255)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 2"/>
                        <TextBox x:Name="BlueInputTextBox"
                                 Height="28"
                                 FontFamily="Consolas, monospace"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Padding="4 2"
                                 TextAlignment="Center"
                                 TextChanged="RgbInputTextBox_TextChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Quick Preset Swatches -->
                <TextBlock Text="Preset Palette" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 10 0 4"/>
                <WrapPanel x:Name="QuickPresetsPanel" Margin="0 0 0 2"/>
            </StackPanel>
        </Border>

        <!-- Footer Action Buttons -->
        <Grid Grid.Row="2" Margin="0 12 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ResetDefaultButton"
                    Grid.Column="0"
                    Content="↺ Default Grey"
                    Style="{StaticResource GhostButton}"
                    Height="30"
                    Padding="10 0"
                    Click="ResetDefaultButton_Click"/>

            <Button Grid.Column="2"
                    Content="Cancel"
                    Style="{StaticResource GhostButton}"
                    Height="30"
                    Width="80"
                    Margin="0 0 8 0"
                    IsCancel="True"
                    Click="CancelButton_Click"/>

            <Button x:Name="ApplyButton"
                    Grid.Column="3"
                    Content="✓ Apply Color"
                    Style="{StaticResource PrimaryButton}"
                    Height="30"
                    Padding="16 0"
                    IsDefault="True"
                    Click="ApplyButton_Click"/>
        </Grid>
    </Grid>
</Window>