<Window x:Class="VitorsWeeklyWorkTracking.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VitorsWeeklyWorkTracking.Controls"
        Title="Work Analytics &amp; Reports"
        Icon="VitorWeeklyWorkTracking.ico"
        Height="720"
        Width="960"
        MinHeight="540"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid Margin="14 12" MinHeight="540">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter Controls Card -->
        <Border Grid.Row="0"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14 10"
                Margin="0 0 0 12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Period, Week navigation & Planner shortcut -->
                <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0 0 0 8">
                    <TextBlock Text="Period:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 6 0" Foreground="{DynamicResource Theme.Foreground}"/>
                    <ComboBox x:Name="PeriodComboBox" Width="125" Margin="0 0 8 0" SelectionChanged="PeriodComboBox_SelectionChanged">
                        <ComboBoxItem Content="This Week" IsSelected="True"/>
                        <ComboBoxItem Content="Last Week"/>
                        <ComboBoxItem Content="This Month"/>
                        <ComboBoxItem Content="Last Month"/>
                        <ComboBoxItem Content="All Time"/>
                        <ComboBoxItem Content="Custom Range"/>
                    </ComboBox>

                    <Button Content="◀ Prev Week" Width="85" Height="28" Margin="0 0 4 0" Click="PrevWeekButton_Click"/>
                    <Button Content="Current Week" Width="90" Height="28" Margin="0 0 4 0" Click="CurrentWeekButton_Click"/>
                    <Button Content="Next Week ▶" Width="85" Height="28" Margin="0 0 10 0" Click="NextWeekButton_Click"/>

                    <Button Content="📅 Work Planner" Style="{StaticResource PrimaryButton}" Height="28" Padding="10 0" Margin="0 0 14 0" Click="OpenCalendarPlanner_Click"/>

                    <TextBlock Text="Project:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 6 0" Foreground="{DynamicResource Theme.Foreground}"/>
                    <ComboBox x:Name="ProjectFilterComboBox" Width="135" Margin="0 0 10 0" SelectionChanged="Filter_SelectionChanged"/>

                    <TextBlock Text="Activity:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 6 0" Foreground="{DynamicResource Theme.Foreground}"/>
                    <ComboBox x:Name="ActivityFilterComboBox" Width="135" SelectionChanged="Filter_SelectionChanged"/>
                </WrapPanel>

                <!-- Row 2: Date Pickers & Range Label -->
                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0 0 6 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                    <DatePicker x:Name="StartDatePicker" Width="125" Margin="0 0 10 0" SelectedDateChanged="DatePicker_SelectedDateChanged"/>

                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="0 0 6 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                    <DatePicker x:Name="EndDatePicker" Width="125" Margin="0 0 12 0" SelectedDateChanged="DatePicker_SelectedDateChanged"/>

                    <TextBlock x:Name="DateRangeLabel" VerticalAlignment="Center" Foreground="{DynamicResource Theme.ForegroundSubtle}" FontStyle="Italic"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- KPI Summary Cards (6 Cards) -->
        <Grid Grid.Row="1" Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Time Worked -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Theme.StatCard1Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard1Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10 8"
                    Margin="0 0 3 0">
                <StackPanel>
                    <TextBlock Text="TOTAL TIME WORKED" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Title}"/>
                    <TextBlock x:Name="TotalTimeTextBlock" Text="0h 00m 00s" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Text}" Margin="0 3 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Planned Goal Target -->
            <Border Grid.Column="1"
                    Background="{DynamicResource Theme.StatCard3Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard3Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10 8"
                    Margin="2 0 2 0">
                <StackPanel>
                    <TextBlock Text="PLANNED GOAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard3Title}"/>
                    <TextBlock x:Name="PlannedGoalTextBlock" Text="0.0 hrs (0%)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard3Text}" Margin="0 3 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Daily Average -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Theme.StatCard2Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard2Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10 8"
                    Margin="2 0 2 0">
                <StackPanel>
                    <TextBlock Text="DAILY AVERAGE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard2Title}"/>
                    <TextBlock x:Name="DailyAverageTextBlock" Text="0h 00m / day" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard2Text}" Margin="0 3 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Total Sessions -->
            <Border Grid.Column="3"
                    Background="{DynamicResource Theme.StatCard4Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard4Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10 8"
                    Margin="2 0 2 0">
                <StackPanel>
                    <TextBlock Text="TOTAL SESSIONS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard4Title}"/>
                    <TextBlock x:Name="TotalSessionsTextBlock" Text="0 sessions" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard4Text}" Margin="0 3 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 5: Top Project -->
            <Border Grid.Column="4"
                    Background="{DynamicResource Theme.StatCard5Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard5Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10 8"
                    Margin="2 0 2 0">
                <StackPanel>
                    <TextBlock Text="TOP PROJECT" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard5Title}"/>
                    <TextBlock x:Name="TopProjectTextBlock" Text="None" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard5Text}" Margin="0 3 0 0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Card 6: Top Activity -->
            <Border Grid.Column="5"
                    Background="{DynamicResource Theme.StatCard1Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard1Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10 8"
                    Margin="3 0 0 0">
                <StackPanel>
                    <TextBlock Text="TOP ACTIVITY" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Title}"/>
                    <TextBlock x:Name="TopActivityTextBlock" Text="None" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Text}" Margin="0 3 0 0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="2">
            <!-- Tab 1: Pie Charts Overview -->
            <TabItem Header="🥧 Pie Charts">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Chart Style & Palette Controls -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource Theme.CardBackground}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12 8"
                            Margin="0 0 0 10">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Chart Style:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 6 0" Foreground="{DynamicResource Theme.Foreground}"/>
                            <ComboBox x:Name="ChartStyleComboBox" Width="135" Margin="0 0 16 0" SelectionChanged="ChartStyleComboBox_SelectionChanged">
                                <ComboBoxItem Content="🍩 Modern Donut" IsSelected="True"/>
                                <ComboBoxItem Content="🥧 Classic Pie"/>
                            </ComboBox>

                            <TextBlock Text="Color Palette:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 6 0" Foreground="{DynamicResource Theme.Foreground}"/>
                            <ComboBox x:Name="ChartPaletteComboBox" Width="165" SelectionChanged="ChartPaletteComboBox_SelectionChanged">
                                <ComboBoxItem Content="✨ Modern Vivid" IsSelected="True"/>
                                <ComboBoxItem Content="⚡ Neon Cyber"/>
                                <ComboBoxItem Content="🍬 Pastel Candy"/>
                                <ComboBoxItem Content="🌊 Ocean Breeze"/>
                                <ComboBoxItem Content="🌅 Sunset Warmth"/>
                                <ComboBoxItem Content="🌲 Forest Nature"/>
                            </ComboBox>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Project Share Pie -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource Theme.CardBackgroundAlt}"
                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                Margin="0 0 4 0">
                            <controls:PieChartControl x:Name="OverviewProjectPieChart"/>
                        </Border>

                        <!-- Activity Share Pie -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource Theme.CardBackgroundAlt}"
                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                Margin="4 0 4 0">
                            <controls:PieChartControl x:Name="OverviewActivityPieChart"/>
                        </Border>

                        <!-- Task Share Pie -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource Theme.CardBackgroundAlt}"
                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                Margin="4 0 0 0">
                            <controls:PieChartControl x:Name="OverviewTaskPieChart"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Goal & Calendar Tracking -->
            <TabItem Header="🎯 Goals &amp; Calendar Tracking">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <!-- Top Goal Progress Headline -->
                        <RowDefinition Height="Auto"/>
                        <!-- Center Split Grid: Daily Accomplishment vs Project Goals -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Goal Summary & Action Bar -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource Theme.CardBackground}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14 10"
                            Margin="0 0 0 10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯 Target Goal (Mon-Sun):" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme.Primary}" Margin="0 0 8 0"/>
                                    <TextBlock x:Name="GoalTabHeadlineText" Text="0.0h planned • 0.0h worked (0%)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}"/>
                                </StackPanel>
                                <ProgressBar x:Name="GoalTabProgressBar" Height="6" Maximum="100" Value="0" Margin="0 6 20 0" Foreground="{DynamicResource Theme.Primary}"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="📅 Open Work Planner"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="30"
                                    Padding="12 0"
                                    Click="OpenCalendarPlanner_Click"/>
                        </Grid>
                    </Border>

                    <!-- Split Grid: Left (Day-by-Day Goal Comparison), Right (Project Goal Comparison) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Daily Goal Accomplishment Table -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource Theme.CardBackground}"
                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True"
                                Margin="0 0 6 0">
                            <Grid>
                                <DataGrid x:Name="GoalsDailyDataGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding FormattedDate}" Width="125"/>
                                        <DataGridTextColumn Header="Day" Binding="{Binding DayOfWeekName}" Width="85"/>
                                        <DataGridTextColumn Header="Planned" Binding="{Binding FormattedPlannedHours}" Width="75"/>
                                        <DataGridTextColumn Header="Actual" Binding="{Binding FormattedActualHours}" Width="75"/>
                                        <DataGridTextColumn Header="Variance" Binding="{Binding FormattedVariance}" Width="80"/>
                                        <DataGridTextColumn Header="Progress" Binding="{Binding FormattedCompletionPercentage}" Width="65"/>
                                        <DataGridTextColumn Header="Goal Status" Binding="{Binding StatusText}" Width="135"/>
                                        <DataGridTextColumn Header="Projects / Plans" Binding="{Binding ProjectsSummary}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Empty State Overlay -->
                                <Border x:Name="GoalsDailyEmptyStatePanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0 35 0 0"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                        <TextBlock Text="🎯" FontSize="24" HorizontalAlignment="Center" Margin="0 0 0 4" Opacity="0.6"/>
                                        <TextBlock Text="No daily goals or tracked work for this period" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Right: Project Goals Table -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource Theme.CardBackground}"
                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True"
                                Margin="6 0 0 0">
                            <Grid>
                                <DataGrid x:Name="GoalsProjectDataGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="140"/>
                                        <DataGridTextColumn Header="Planned" Binding="{Binding FormattedPlanned}" Width="65"/>
                                        <DataGridTextColumn Header="Actual" Binding="{Binding FormattedActual}" Width="75"/>
                                        <DataGridTextColumn Header="Progress" Binding="{Binding FormattedPercentage}" Width="65"/>
                                        <DataGridTemplateColumn Header="Bar" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ProgressBar Value="{Binding CompletionPercentage, Mode=OneWay}" Maximum="100" Height="10" Margin="4 0" Foreground="{DynamicResource Theme.Primary}" Background="{DynamicResource Theme.SecondaryBorder}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Empty State Overlay -->
                                <Border x:Name="GoalsProjectEmptyStatePanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0 35 0 0"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                        <TextBlock Text="🎯" FontSize="20" HorizontalAlignment="Center" Margin="0 0 0 4" Opacity="0.6"/>
                                        <TextBlock Text="No project goals for this period" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Project Breakdown -->
            <TabItem Header="📁 Project Breakdown">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="290"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{DynamicResource Theme.CardBackground}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <DataGrid x:Name="ProjectsDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="160"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="110"/>
                                    <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=\{0:F2\} hrs}" Width="85"/>
                                    <DataGridTextColumn Header="Sessions" Binding="{Binding EntryCount}" Width="65"/>
                                    <DataGridTextColumn Header="Share (%)" Binding="{Binding FormattedPercentage}" Width="75"/>
                                    <DataGridTemplateColumn Header="Distribution" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Height="14" Margin="5 0" Foreground="{DynamicResource Theme.Primary}" Background="{DynamicResource Theme.SecondaryBorder}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State Overlay -->
                            <Border x:Name="ProjectsEmptyStatePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0 35 0 0"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                                    <TextBlock Text="📁" FontSize="26" HorizontalAlignment="Center" Margin="0 0 0 6" Opacity="0.6"/>
                                    <TextBlock Text="There are no project entries currently" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Adjust your period or project filters to view project distribution" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center" Margin="0 4 0 0" Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1"
                            Background="{DynamicResource Theme.CardBackgroundAlt}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="8 0 0 0">
                        <controls:PieChartControl x:Name="ProjectPieChart"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 3: Activity Breakdown -->
            <TabItem Header="🏷️ Activity Breakdown">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="290"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{DynamicResource Theme.CardBackground}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <DataGrid x:Name="ActivitiesDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Activity" Binding="{Binding Activity}" Width="160"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="110"/>
                                    <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=\{0:F2\} hrs}" Width="85"/>
                                    <DataGridTextColumn Header="Sessions" Binding="{Binding EntryCount}" Width="65"/>
                                    <DataGridTextColumn Header="Share (%)" Binding="{Binding FormattedPercentage}" Width="75"/>
                                    <DataGridTemplateColumn Header="Distribution" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Height="14" Margin="5 0" Foreground="{DynamicResource Theme.Accent}" Background="{DynamicResource Theme.SecondaryBorder}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State Overlay -->
                            <Border x:Name="ActivitiesEmptyStatePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0 35 0 0"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                                    <TextBlock Text="🏷️" FontSize="26" HorizontalAlignment="Center" Margin="0 0 0 6" Opacity="0.6"/>
                                    <TextBlock Text="There are no activity entries currently" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Adjust your period or activity filters to view activity distribution" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center" Margin="0 4 0 0" Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1"
                            Background="{DynamicResource Theme.CardBackgroundAlt}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="8 0 0 0">
                        <controls:PieChartControl x:Name="ActivityPieChart"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 4: Task Breakdown -->
            <TabItem Header="📝 Task Breakdown">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="290"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{DynamicResource Theme.CardBackground}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <DataGrid x:Name="TasksDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Task / Description" Binding="{Binding Description}" Width="180"/>
                                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="120"/>
                                    <DataGridTextColumn Header="Activity" Binding="{Binding Activity}" Width="110"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="100"/>
                                    <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=\{0:F2\} hrs}" Width="80"/>
                                    <DataGridTextColumn Header="Sessions" Binding="{Binding EntryCount}" Width="65"/>
                                    <DataGridTextColumn Header="Share (%)" Binding="{Binding FormattedPercentage}" Width="75"/>
                                    <DataGridTemplateColumn Header="Distribution" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Height="14" Margin="5 0" Foreground="{DynamicResource Theme.Warning}" Background="{DynamicResource Theme.SecondaryBorder}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State Overlay -->
                            <Border x:Name="TasksEmptyStatePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0 35 0 0"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                                    <TextBlock Text="📝" FontSize="26" HorizontalAlignment="Center" Margin="0 0 0 6" Opacity="0.6"/>
                                    <TextBlock Text="There are no task entries currently" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Track sessions with task descriptions to view task breakdown" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center" Margin="0 4 0 0" Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1"
                            Background="{DynamicResource Theme.CardBackgroundAlt}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="8 0 0 0">
                        <controls:PieChartControl x:Name="TaskPieChart"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 6: Daily Breakdown -->
            <TabItem Header="📅 Daily Breakdown">
                <Grid Margin="6">
                    <Border Background="{DynamicResource Theme.CardBackground}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <DataGrid x:Name="DailyDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding FormattedDate}" Width="120"/>
                                    <DataGridTextColumn Header="Day" Binding="{Binding DayOfWeekName}" Width="85"/>
                                    <DataGridTextColumn Header="Planned" Binding="{Binding FormattedPlannedHours}" Width="75"/>
                                    <DataGridTextColumn Header="Actual" Binding="{Binding FormattedDuration}" Width="95"/>
                                    <DataGridTextColumn Header="Variance" Binding="{Binding FormattedVariance}" Width="75"/>
                                    <DataGridTextColumn Header="Goal Status" Binding="{Binding GoalStatusText}" Width="130"/>
                                    <DataGridTextColumn Header="Sessions" Binding="{Binding EntryCount}" Width="65"/>
                                    <DataGridTextColumn Header="Projects" Binding="{Binding ProjectsSummary}" Width="130"/>
                                    <DataGridTextColumn Header="Activities" Binding="{Binding ActivitiesSummary}" Width="130"/>
                                    <DataGridTextColumn Header="Tasks / Descriptions" Binding="{Binding TasksSummary}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State Overlay -->
                            <Border x:Name="DailyEmptyStatePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0 35 0 0"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                                    <TextBlock Text="📅" FontSize="26" HorizontalAlignment="Center" Margin="0 0 0 6" Opacity="0.6"/>
                                    <TextBlock Text="There are no daily entries currently" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Adjust your period filters to view day-by-day statistics" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center" Margin="0 4 0 0" Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 6: Detailed Entries Log -->
            <TabItem Header="📋 Tasks / Work Log">
                <Grid Margin="6">
                    <Border Background="{DynamicResource Theme.CardBackground}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <DataGrid x:Name="EntriesDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding StartTime, StringFormat=\{0:yyyy-MM-dd\}}" Width="95"/>
                                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="135"/>
                                    <DataGridTextColumn Header="Activity" Binding="{Binding Activity}" Width="120"/>
                                    <DataGridTextColumn Header="Task / Description" Binding="{Binding Description}" Width="180"/>
                                    <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat=\{0:HH:mm:ss\}}" Width="75"/>
                                    <DataGridTextColumn Header="End" Binding="{Binding EndTime, StringFormat=\{0:HH:mm:ss\}}" Width="75"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration, StringFormat=\{0:hh\\:mm\\:ss\}}" Width="80"/>
                                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State Overlay -->
                            <Border x:Name="EntriesEmptyStatePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0 35 0 0"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                                    <TextBlock Text="📋" FontSize="26" HorizontalAlignment="Center" Margin="0 0 0 6" Opacity="0.6"/>
                                    <TextBlock Text="There are no work log entries currently" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Adjust your period or project filters to view recorded sessions" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center" Margin="0 4 0 0" Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Actions -->
        <Grid Grid.Row="3" Margin="0 12 0 0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="📥 Export Report CSV"
                        Style="{StaticResource PrimaryButton}"
                        Width="160"
                        Click="ExportReportButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Width="90" IsCancel="True" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
