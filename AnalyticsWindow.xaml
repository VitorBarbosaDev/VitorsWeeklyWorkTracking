<Window x:Class="VitorsWeeklyWorkTracking.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VitorsWeeklyWorkTracking.Controls"
        Title="Work Analytics &amp; Reports"
        Height="700"
        Width="1080"
        MinHeight="550"
        MinWidth="850"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter Controls -->
        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0 0 0 12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Period and Week navigation -->
                <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0 0 0 8">
                    <TextBlock Text="Period:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 6 0"/>
                    <ComboBox x:Name="PeriodComboBox" Width="120" Margin="0 0 10 0" SelectionChanged="PeriodComboBox_SelectionChanged">
                        <ComboBoxItem Content="This Week" IsSelected="True"/>
                        <ComboBoxItem Content="Last Week"/>
                        <ComboBoxItem Content="This Month"/>
                        <ComboBoxItem Content="Last Month"/>
                        <ComboBoxItem Content="All Time"/>
                        <ComboBoxItem Content="Custom Range"/>
                    </ComboBox>

                    <Button Content="◀ Prev Week" Width="85" Margin="0 0 4 0" Click="PrevWeekButton_Click"/>
                    <Button Content="Current Week" Width="90" Margin="0 0 4 0" Click="CurrentWeekButton_Click"/>
                    <Button Content="Next Week ▶" Width="85" Margin="0 0 12 0" Click="NextWeekButton_Click"/>

                    <TextBlock Text="Project:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 6 0"/>
                    <ComboBox x:Name="ProjectFilterComboBox" Width="140" Margin="0 0 10 0" SelectionChanged="Filter_SelectionChanged"/>

                    <TextBlock Text="Activity:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 6 0"/>
                    <ComboBox x:Name="ActivityFilterComboBox" Width="140" SelectionChanged="Filter_SelectionChanged"/>
                </WrapPanel>

                <!-- Row 2: Date Pickers & Range Label -->
                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0 0 6 0"/>
                    <DatePicker x:Name="StartDatePicker" Width="125" Margin="0 0 12 0" SelectedDateChanged="DatePicker_SelectedDateChanged"/>

                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="0 0 6 0"/>
                    <DatePicker x:Name="EndDatePicker" Width="125" Margin="0 0 12 0" SelectedDateChanged="DatePicker_SelectedDateChanged"/>

                    <TextBlock x:Name="DateRangeLabel" VerticalAlignment="Center" Foreground="#555555" FontStyle="Italic"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- KPI Summary Cards -->
        <Grid Grid.Row="1" Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Time -->
            <Border Grid.Column="0" Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0 0 4 0">
                <StackPanel>
                    <TextBlock Text="TOTAL TIME WORKED" FontSize="11" FontWeight="Bold" Foreground="#1565C0"/>
                    <TextBlock x:Name="TotalTimeTextBlock" Text="0h 00m 00s" FontSize="16" FontWeight="Bold" Foreground="#0D47A1" Margin="0 4 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Daily Average -->
            <Border Grid.Column="1" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="2 0 2 0">
                <StackPanel>
                    <TextBlock Text="DAILY AVERAGE" FontSize="11" FontWeight="Bold" Foreground="#2E7D32"/>
                    <TextBlock x:Name="DailyAverageTextBlock" Text="0h 00m / day" FontSize="16" FontWeight="Bold" Foreground="#1B5E20" Margin="0 4 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Total Sessions -->
            <Border Grid.Column="2" Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="1" CornerRadius="6" Padding="10" Margin="2 0 2 0">
                <StackPanel>
                    <TextBlock Text="TOTAL SESSIONS" FontSize="11" FontWeight="Bold" Foreground="#E65100"/>
                    <TextBlock x:Name="TotalSessionsTextBlock" Text="0 sessions" FontSize="16" FontWeight="Bold" Foreground="#BF360C" Margin="0 4 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Top Project -->
            <Border Grid.Column="3" Background="#F3E5F5" BorderBrush="#CE93D8" BorderThickness="1" CornerRadius="6" Padding="10" Margin="2 0 2 0">
                <StackPanel>
                    <TextBlock Text="TOP PROJECT" FontSize="11" FontWeight="Bold" Foreground="#7B1FA2"/>
                    <TextBlock x:Name="TopProjectTextBlock" Text="None" FontSize="15" FontWeight="Bold" Foreground="#4A148C" Margin="0 4 0 0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Card 5: Top Activity -->
            <Border Grid.Column="4" Background="#FBE9E7" BorderBrush="#FFAB91" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4 0 0 0">
                <StackPanel>
                    <TextBlock Text="TOP ACTIVITY" FontSize="11" FontWeight="Bold" Foreground="#D84315"/>
                    <TextBlock x:Name="TopActivityTextBlock" Text="None" FontSize="15" FontWeight="Bold" Foreground="#BF360C" Margin="0 4 0 0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="2">
            <!-- Tab 1: Pie Charts Overview -->
            <TabItem Header="Pie Charts">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Project Share Pie -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0 0 4 0">
                        <controls:PieChartControl x:Name="OverviewProjectPieChart"/>
                    </Border>

                    <!-- Activity Share Pie -->
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="4 0 4 0">
                        <controls:PieChartControl x:Name="OverviewActivityPieChart"/>
                    </Border>

                    <!-- Task Share Pie -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="4 0 0 0">
                        <controls:PieChartControl x:Name="OverviewTaskPieChart"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Project Breakdown -->
            <TabItem Header="Project Breakdown">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="ProjectsDataGrid"
                              Grid.Column="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              AlternatingRowBackground="#F9F9F9"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="160"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="110"/>
                            <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=\{0:F2\} hrs}" Width="85"/>
                            <DataGridTextColumn Header="Sessions" Binding="{Binding EntryCount}" Width="65"/>
                            <DataGridTextColumn Header="Share (%)" Binding="{Binding FormattedPercentage}" Width="75"/>
                            <DataGridTemplateColumn Header="Distribution" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="14" Margin="5 0" Foreground="#1976D2" Background="#E0E0E0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="8 0 0 0">
                        <controls:PieChartControl x:Name="ProjectPieChart"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 3: Activity Breakdown -->
            <TabItem Header="Activity Breakdown">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="ActivitiesDataGrid"
                              Grid.Column="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              AlternatingRowBackground="#F9F9F9"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Activity" Binding="{Binding Activity}" Width="160"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="110"/>
                            <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=\{0:F2\} hrs}" Width="85"/>
                            <DataGridTextColumn Header="Sessions" Binding="{Binding EntryCount}" Width="65"/>
                            <DataGridTextColumn Header="Share (%)" Binding="{Binding FormattedPercentage}" Width="75"/>
                            <DataGridTemplateColumn Header="Distribution" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="14" Margin="5 0" Foreground="#D84315" Background="#E0E0E0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="8 0 0 0">
                        <controls:PieChartControl x:Name="ActivityPieChart"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 4: Task Breakdown -->
            <TabItem Header="Task Breakdown">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="TasksDataGrid"
                              Grid.Column="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              AlternatingRowBackground="#F9F9F9"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Task / Description" Binding="{Binding Description}" Width="180"/>
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="120"/>
                            <DataGridTextColumn Header="Activity" Binding="{Binding Activity}" Width="110"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="100"/>
                            <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=\{0:F2\} hrs}" Width="80"/>
                            <DataGridTextColumn Header="Sessions" Binding="{Binding EntryCount}" Width="65"/>
                            <DataGridTextColumn Header="Share (%)" Binding="{Binding FormattedPercentage}" Width="75"/>
                            <DataGridTemplateColumn Header="Distribution" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="14" Margin="5 0" Foreground="#7B1FA2" Background="#E0E0E0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="8 0 0 0">
                        <controls:PieChartControl x:Name="TaskPieChart"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 5: Daily Breakdown -->
            <TabItem Header="Daily Breakdown">
                <Grid Margin="6">
                    <DataGrid x:Name="DailyDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              AlternatingRowBackground="#F9F9F9"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding FormattedDate}" Width="140"/>
                            <DataGridTextColumn Header="Day" Binding="{Binding DayOfWeekName}" Width="95"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="115"/>
                            <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=\{0:F2\} hrs}" Width="85"/>
                            <DataGridTextColumn Header="Sessions" Binding="{Binding EntryCount}" Width="70"/>
                            <DataGridTextColumn Header="Projects" Binding="{Binding ProjectsSummary}" Width="140"/>
                            <DataGridTextColumn Header="Activities" Binding="{Binding ActivitiesSummary}" Width="140"/>
                            <DataGridTextColumn Header="Tasks / Descriptions" Binding="{Binding TasksSummary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 6: Detailed Entries Log -->
            <TabItem Header="Tasks / Work Log">
                <Grid Margin="6">
                    <DataGrid x:Name="EntriesDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              AlternatingRowBackground="#F9F9F9"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding StartTime, StringFormat=\{0:yyyy-MM-dd\}}" Width="95"/>
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="135"/>
                            <DataGridTextColumn Header="Activity" Binding="{Binding Activity}" Width="120"/>
                            <DataGridTextColumn Header="Task / Description" Binding="{Binding Description}" Width="180"/>
                            <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat=\{0:HH:mm:ss\}}" Width="75"/>
                            <DataGridTextColumn Header="End" Binding="{Binding EndTime, StringFormat=\{0:HH:mm:ss\}}" Width="75"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration, StringFormat=\{0:hh\\:mm\\:ss\}}" Width="80"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Actions -->
        <Grid Grid.Row="3" Margin="0 12 0 0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Export Report CSV" Width="140" Click="ExportReportButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Width="80" IsCancel="True" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
