<Window x:Class="VitorsWeeklyWorkTracking.CopyToOtherDaysDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy Task to Other Days"
        Icon="VitorWeeklyWorkTracking.ico"
        Width="460"
        Height="510"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Task Preview Card -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Days Input Section -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Live Preview & Range -->
                <RowDefinition Height="*"/>
                <!-- 4: Action Footer Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14 12"
                    Margin="0 0 0 12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📋" FontSize="26" VerticalAlignment="Center" Margin="0 0 12 0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Copy Task to Other Days" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}"/>
                        <TextBlock Text="Extend and duplicate this planned session across subsequent days" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 2 0 0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. Task Preview Card -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Theme.CardBackgroundAlt}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12 10"
                    Margin="0 0 0 12">
                <StackPanel>
                    <Grid Margin="0 0 0 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📁 " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProjectNameText"
                                       Text="Project Name"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{DynamicResource Theme.Foreground}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{DynamicResource Theme.CardBackground}"
                                BorderBrush="{DynamicResource Theme.Primary}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6 2">
                            <TextBlock x:Name="PlannedHoursText"
                                       Text="4.0 hrs/day"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Theme.Primary}"/>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                        <TextBlock x:Name="SourceDateText"
                                   Text="📅 Monday, 05 Oct 2026"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.ForegroundMuted}"
                                   Margin="0 0 12 0"/>
                        <TextBlock x:Name="ActivityText"
                                   Text="🏷️ Development"
                                   FontSize="11"
                                   Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                    </StackPanel>

                    <TextBlock x:Name="NoteText"
                               Text="Task notes here"
                               FontSize="10.5"
                               FontStyle="Italic"
                               Foreground="{DynamicResource Theme.ForegroundSubtle}"
                               Margin="0 4 0 0"
                               TextWrapping="Wrap"
                               MaxHeight="36"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 2. Days Input Section -->
            <StackPanel Grid.Row="2" Margin="0 0 0 10">
                <TextBlock Text="How many days do you want to extend it to?"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource Theme.Foreground}"
                           Margin="0 0 0 6"/>

                <Grid Margin="0 0 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="−"
                            FontSize="16"
                            FontWeight="Bold"
                            Height="34"
                            Style="{StaticResource GhostButton}"
                            Click="DecrementDaysButton_Click"
                            ToolTip="Decrease days"/>

                    <TextBox x:Name="DaysTextBox"
                             Grid.Column="1"
                             Height="40"
                             FontSize="15"
                             FontWeight="Bold"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Margin="4 0"
                             PreviewTextInput="DaysTextBox_PreviewTextInput"
                             TextChanged="DaysTextBox_TextChanged"
                             KeyDown="DaysTextBox_KeyDown"/>

                    <Button Grid.Column="2"
                            Content="+"
                            FontSize="16"
                            FontWeight="Bold"
                            Height="34"
                            Style="{StaticResource GhostButton}"
                            Click="IncrementDaysButton_Click"
                            ToolTip="Increase days"/>

                    <TextBlock Grid.Column="3"
                               Text="days"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.ForegroundMuted}"
                               VerticalAlignment="Center"
                               Margin="10 0 0 0"/>
                </Grid>

                <!-- Quick Preset Chips -->
                <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                    <TextBlock Text="Quick:" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" VerticalAlignment="Center" Margin="0 0 6 0"/>
                    <Button Content="+1 day" Style="{StaticResource GhostButton}" Padding="6 2" Margin="0 0 4 0" FontSize="11" Click="QuickPreset_Click" Tag="1"/>
                    <Button Content="+2 days" Style="{StaticResource GhostButton}" Padding="6 2" Margin="0 0 4 0" FontSize="11" Click="QuickPreset_Click" Tag="2"/>
                    <Button Content="+3 days" Style="{StaticResource GhostButton}" Padding="6 2" Margin="0 0 4 0" FontSize="11" Click="QuickPreset_Click" Tag="3"/>
                    <Button Content="+4 days" Style="{StaticResource GhostButton}" Padding="6 2" Margin="0 0 4 0" FontSize="11" Click="QuickPreset_Click" Tag="4"/>
                    <Button Content="+5 days" Style="{StaticResource GhostButton}" Padding="6 2" Margin="0 0 4 0" FontSize="11" Click="QuickPreset_Click" Tag="5"/>
                    <Button Content="+7 days" Style="{StaticResource GhostButton}" Padding="6 2" Margin="0 0 4 0" FontSize="11" Click="QuickPreset_Click" Tag="7"/>
                </StackPanel>
            </StackPanel>

            <!-- 3. Live Preview & Range Box -->
            <Border Grid.Row="3"
                    Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12 10"
                    Margin="0 0 0 14"
                    VerticalAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="📅 EXTENSION PREVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                        <TextBlock x:Name="TargetDatesText"
                                   Text="Will be copied to..."
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{DynamicResource Theme.Foreground}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="SummaryTotalText"
                                   Text="Total planned hours to add: 0.0 hrs"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.Primary}"
                                   Margin="0 6 0 0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 4. Action Footer Buttons -->
            <Grid Grid.Row="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Width="85"
                            Height="32"
                            Margin="0 0 8 0"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button x:Name="CopySubmitButton"
                            Content="📋 Copy Task"
                            Style="{StaticResource PrimaryButton}"
                            Padding="14 0"
                            Height="32"
                            IsDefault="True"
                            Click="CopyButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>