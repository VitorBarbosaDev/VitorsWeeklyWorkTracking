<Window x:Class="VitorsWeeklyWorkTracking.EditTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Task Details"
        Icon="VitorWeeklyWorkTracking.ico"
        Width="520"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Form Content -->
                <RowDefinition Height="*"/>
                <!-- 2: Action Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14 12"
                    Margin="0 0 0 14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="✏️" FontSize="26" VerticalAlignment="Center" Margin="0 0 12 0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Edit Task Details" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}"/>
                        <TextBlock Text="Update the task project, activity, times, description, or notes" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 2 0 0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. Form Content in ScrollViewer -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0 0 0 12">
                <StackPanel Margin="0 0 6 0">
                    <!-- Project & Activity Row -->
                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Project -->
                        <StackPanel Grid.Column="0" Margin="0 0 6 0">
                            <TextBlock Text="📁 Project" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                            <ComboBox x:Name="ProjectComboBox"
                                      IsEditable="True"
                                      Height="32"
                                      VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Activity -->
                        <StackPanel Grid.Column="1" Margin="6 0 0 0">
                            <TextBlock Text="🏷️ Activity" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                            <ComboBox x:Name="ActivityComboBox"
                                      IsEditable="True"
                                      Height="32"
                                      VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Task Description -->
                    <StackPanel Margin="0 0 0 12">
                        <TextBlock Text="📝 Task / Description" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                        <TextBox x:Name="DescriptionTextBox"
                                 Height="40"
                                 Padding="8 5"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Start & End Time Section -->
                    <Border Background="{DynamicResource Theme.CardBackgroundAlt}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12 10"
                            Margin="0 0 0 12">
                        <StackPanel>
                            <TextBlock Text="⏱️ Work Session Period" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Foreground}" Margin="0 0 0 8"/>

                            <!-- Start Time Row -->
                            <Grid Margin="0 0 0 8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Theme.ForegroundMuted}" VerticalAlignment="Center"/>
                                <DatePicker x:Name="StartDatePicker"
                                            Grid.Column="1"
                                            Height="30"
                                            Margin="0 0 6 0"
                                            SelectedDateChanged="TimeInputs_Changed"/>
                                <TextBox x:Name="StartTimeTextBox"
                                         Grid.Column="2"
                                         Height="30"
                                         Padding="6 4"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Enter time as HH:mm:ss or HH:mm (24-hour format)"
                                         TextChanged="TimeInputs_Changed"/>
                            </Grid>

                            <!-- End Time Row -->
                            <Grid Margin="0 0 0 8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="End:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Theme.ForegroundMuted}" VerticalAlignment="Center"/>
                                <DatePicker x:Name="EndDatePicker"
                                            Grid.Column="1"
                                            Height="30"
                                            Margin="0 0 6 0"
                                            SelectedDateChanged="TimeInputs_Changed"/>
                                <TextBox x:Name="EndTimeTextBox"
                                         Grid.Column="2"
                                         Height="30"
                                         Padding="6 4"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Enter time as HH:mm:ss or HH:mm (24-hour format)"
                                         TextChanged="TimeInputs_Changed"/>
                            </Grid>

                            <!-- Quick Duration Helper / Calculation Banner -->
                            <Border x:Name="DurationPreviewBorder"
                                    Background="{DynamicResource Theme.CardBackground}"
                                    BorderBrush="{DynamicResource Theme.Primary}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10 6"
                                    Margin="0 2 0 0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DurationPreviewText"
                                               Text="Calculated Duration: 0h 00m 00s"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Theme.Primary}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="+15m"
                                                Style="{StaticResource GhostButton}"
                                                Padding="4 1"
                                                FontSize="10"
                                                Margin="0 0 3 0"
                                                Click="AddMinutesToEnd_Click"
                                                Tag="15"/>
                                        <Button Content="+30m"
                                                Style="{StaticResource GhostButton}"
                                                Padding="4 1"
                                                FontSize="10"
                                                Margin="0 0 3 0"
                                                Click="AddMinutesToEnd_Click"
                                                Tag="30"/>
                                        <Button Content="+1h"
                                                Style="{StaticResource GhostButton}"
                                                Padding="4 1"
                                                FontSize="10"
                                                Click="AddMinutesToEnd_Click"
                                                Tag="60"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Notes Section -->
                    <StackPanel Margin="0 0 0 4">
                        <TextBlock Text="📄 Notes (Detailed context &amp; remarks)" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                        <TextBox x:Name="NoteTextBox"
                                 Height="85"
                                 Padding="8 6"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. Action Buttons Footer -->
            <Grid Grid.Row="2" Margin="0 4 0 0">
                <TextBlock x:Name="ValidationStatusText"
                           Text=""
                           Foreground="{DynamicResource Theme.Danger}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Width="85"
                            Height="32"
                            Margin="0 0 8 0"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button x:Name="SaveButton"
                            Content="💾 Save Changes"
                            Style="{StaticResource PrimaryButton}"
                            Width="130"
                            Height="32"
                            IsDefault="True"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
