<Window x:Class="VitorsWeeklyWorkTracking.EditMilestoneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Milestone Details"
        Icon="VitorWeeklyWorkTracking.ico"
        Width="490"
        Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}">
    <Border Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Form Content -->
                <RowDefinition Height="*"/>
                <!-- 2: Action Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14 12"
                    Margin="0 0 0 14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderIconTextBlock" Text="🚩" FontSize="26" VerticalAlignment="Center" Margin="0 0 12 0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleTextBlock" Text="Add Project Milestone" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}"/>
                        <TextBlock x:Name="HeaderSubtitleTextBlock" Text="Set important project dates and daily countdown reminders" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 2 0 0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. Form Content in ScrollViewer -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0 0 0 12">
                <StackPanel Margin="0 0 4 0">
                    <!-- Project Selector -->
                    <StackPanel Margin="0 0 0 12">
                        <TextBlock Text="📁 Project" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                        <ComboBox x:Name="ProjectComboBox"
                                  IsEditable="True"
                                  TextSearch.TextPath="Name"
                                  Height="32"
                                  VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Brush}" Margin="0 0 7 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Foreground}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Milestone Title -->
                    <StackPanel Margin="0 0 0 12">
                        <TextBlock Text="🎯 Milestone / Event Name" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                        <TextBox x:Name="TitleTextBox"
                                 Height="34"
                                 Padding="8 4"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Target Date & Countdown Preview -->
                    <Border Background="{DynamicResource Theme.CardBackgroundAlt}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12 10"
                            Margin="0 0 0 12">
                        <StackPanel>
                            <TextBlock Text="📅 Target Date &amp; Countdown" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Foreground}" Margin="0 0 0 8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="TargetDatePicker"
                                            Height="30"
                                            SelectedDateChanged="TargetDatePicker_SelectedDateChanged"/>
                                <Border Grid.Column="1"
                                        x:Name="CountdownBadge"
                                        Background="{DynamicResource Theme.CardBackground}"
                                        BorderBrush="{DynamicResource Theme.CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10 4"
                                        Margin="8 0 0 0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="CountdownPreviewTextBlock"
                                               Text="⏳ 0 days remaining"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Foreground="{DynamicResource Theme.Primary}"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Notes / Description -->
                    <StackPanel Margin="0 0 0 12">
                        <TextBlock Text="📝 Description / Notes (Optional)" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                        <TextBox x:Name="DescriptionTextBox"
                                 Height="65"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8 6"/>
                    </StackPanel>

                    <!-- Completed Checkbox (for editing) -->
                    <CheckBox x:Name="CompletedCheckBox"
                              Content="Mark as completed"
                              FontWeight="SemiBold"
                              FontSize="12"
                              Margin="0 0 0 4"
                              Checked="CompletedCheckBox_CheckChanged"
                              Unchecked="CompletedCheckBox_CheckChanged"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. Action Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="DeleteButton"
                        Content="🗑️ Delete"
                        Style="{StaticResource DangerButton}"
                        Padding="12 6"
                        Visibility="Collapsed"
                        Click="DeleteButton_Click"/>

                <Button Grid.Column="1"
                        Content="Cancel"
                        Style="{StaticResource GhostButton}"
                        Padding="14 6"
                        Margin="0 0 8 0"
                        Click="CancelButton_Click"/>

                <Button Grid.Column="2"
                        x:Name="SaveButton"
                        Content="💾 Save Milestone"
                        Style="{StaticResource PrimaryButton}"
                        Padding="18 6"
                        FontWeight="Bold"
                        Click="SaveButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
