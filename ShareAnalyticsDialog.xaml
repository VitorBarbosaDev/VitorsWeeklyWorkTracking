<Window x:Class="VitorsWeeklyWorkTracking.ShareAnalyticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share Analytics"
        Icon="VitorWeeklyWorkTracking.ico"
        Width="750"
        Height="680"
        MinWidth="600"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}">
    <Border Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header Banner -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Summary Metric Stat Cards -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Detailed Breakdown Tabs -->
                <RowDefinition Height="*"/>
                <!-- 3: Action Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0: Header Banner -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14 12"
                    Margin="0 0 0 10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="HeaderIconText" Text="📁" FontSize="30" VerticalAlignment="Center" Margin="0 0 12 0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 3">
                            <Border x:Name="CategoryBadgeBorder"
                                    Background="{DynamicResource Theme.Secondary}"
                                    BorderBrush="{DynamicResource Theme.CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6 2"
                                    Margin="0 0 8 0">
                                <TextBlock x:Name="CategoryBadgeText" Text="PROJECT SHARE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Primary}"/>
                            </Border>
                            <TextBlock x:Name="PeriodText" Text="Period: 2026-09-28 – 2026-10-04" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="ShareTitleText" Text="Share Name" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="{DynamicResource Theme.StatCard1Bg}"
                            BorderBrush="{DynamicResource Theme.StatCard1Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12 6"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SHARE OF TOTAL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Title}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SharePercentageBadgeText" Text="0.0%" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Text}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 1: Summary Metric Stat Cards -->
            <Grid Grid.Row="1" Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Time -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Theme.StatCard3Bg}"
                        BorderBrush="{DynamicResource Theme.StatCard3Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8 6"
                        Margin="0 0 3 0">
                    <StackPanel>
                        <TextBlock Text="TOTAL TIME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard3Title}"/>
                        <TextBlock x:Name="TotalTimeStatText" Text="0m" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard3Text}" Margin="0 2 0 0"/>
                        <TextBlock x:Name="TotalHoursDecimalText" Text="0.00 hrs" FontSize="10" Foreground="{DynamicResource Theme.StatCard3Title}" Margin="0 1 0 0" Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <!-- Sessions Count -->
                <Border Grid.Column="1"
                        Background="{DynamicResource Theme.StatCard4Bg}"
                        BorderBrush="{DynamicResource Theme.StatCard4Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8 6"
                        Margin="3 0 3 0">
                    <StackPanel>
                        <TextBlock Text="SESSIONS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard4Title}"/>
                        <TextBlock x:Name="SessionsCountStatText" Text="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard4Text}" Margin="0 2 0 0"/>
                        <TextBlock Text="recorded" FontSize="10" Foreground="{DynamicResource Theme.StatCard4Title}" Margin="0 1 0 0" Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <!-- Active Days -->
                <Border Grid.Column="2"
                        Background="{DynamicResource Theme.StatCard2Bg}"
                        BorderBrush="{DynamicResource Theme.StatCard2Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8 6"
                        Margin="3 0 3 0">
                    <StackPanel>
                        <TextBlock Text="ACTIVE DAYS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard2Title}"/>
                        <TextBlock x:Name="ActiveDaysStatText" Text="0 days" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard2Text}" Margin="0 2 0 0"/>
                        <TextBlock x:Name="ActiveDaysSubtitleText" Text="with activity" FontSize="10" Foreground="{DynamicResource Theme.StatCard2Title}" Margin="0 1 0 0" Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <!-- Avg Session -->
                <Border Grid.Column="3"
                        Background="{DynamicResource Theme.StatCard5Bg}"
                        BorderBrush="{DynamicResource Theme.StatCard5Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8 6"
                        Margin="3 0 3 0">
                    <StackPanel>
                        <TextBlock Text="AVG SESSION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard5Title}"/>
                        <TextBlock x:Name="AvgSessionStatText" Text="0m" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard5Text}" Margin="0 2 0 0"/>
                        <TextBlock Text="per session" FontSize="10" Foreground="{DynamicResource Theme.StatCard5Title}" Margin="0 1 0 0" Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <!-- Daily Average -->
                <Border Grid.Column="4"
                        Background="{DynamicResource Theme.StatCard1Bg}"
                        BorderBrush="{DynamicResource Theme.StatCard1Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8 6"
                        Margin="3 0 0 0">
                    <StackPanel>
                        <TextBlock Text="DAILY AVG" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Title}"/>
                        <TextBlock x:Name="DailyAverageStatText" Text="0m" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Text}" Margin="0 2 0 0"/>
                        <TextBlock Text="per active day" FontSize="10" Foreground="{DynamicResource Theme.StatCard1Title}" Margin="0 1 0 0" Opacity="0.8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2: Detailed Breakdown Tabs -->
            <TabControl Grid.Row="2" Margin="0 0 0 10">
                <!-- Tab 1: Detailed Breakdown -->
                <TabItem Header="📊 Breakdown">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Primary Sub-Breakdown -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource Theme.CardBackground}"
                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{DynamicResource Theme.CardHeaderBackground}"
                                        BorderBrush="{DynamicResource Theme.CardBorder}"
                                        BorderThickness="0 0 0 1"
                                        Padding="10 6">
                                    <TextBlock x:Name="PrimaryBreakdownTitleText" Text="Activity Distribution" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Foreground}"/>
                                </Border>
                                <DataGrid x:Name="PrimaryBreakdownDataGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
                                        <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="95"/>
                                        <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=\{0:F2\} hrs}" Width="80"/>
                                        <DataGridTextColumn Header="Share" Binding="{Binding FormattedPercentage}" Width="70"/>
                                        <DataGridTextColumn Header="Sessions" Binding="{Binding EntryCount}" Width="65"/>
                                        <DataGridTemplateColumn Header="Distribution" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Height="12" Margin="4 0" Foreground="{DynamicResource Theme.Primary}" Background="{DynamicResource Theme.SecondaryBorder}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Row="1"
                                      Height="10"
                                      HorizontalAlignment="Stretch"
                                      Style="{StaticResource ModernHorizontalGridSplitter}"
                                      ToolTip="Drag to resize breakdown tables"/>

                        <!-- Secondary Sub-Breakdown -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource Theme.CardBackground}"
                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{DynamicResource Theme.CardHeaderBackground}"
                                        BorderBrush="{DynamicResource Theme.CardBorder}"
                                        BorderThickness="0 0 0 1"
                                        Padding="10 6">
                                    <TextBlock x:Name="SecondaryBreakdownTitleText" Text="Task &amp; Description Distribution" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Foreground}"/>
                                </Border>
                                <DataGrid x:Name="SecondaryBreakdownDataGrid"
                                          Grid.Row="1"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Task / Description" Binding="{Binding Name}" Width="200"/>
                                        <DataGridTextColumn Header="Details" Binding="{Binding Subtitle}" Width="120"/>
                                        <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="95"/>
                                        <DataGridTextColumn Header="Share" Binding="{Binding FormattedPercentage}" Width="70"/>
                                        <DataGridTextColumn Header="Sessions" Binding="{Binding EntryCount}" Width="65"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Daily Distribution -->
                <TabItem Header="📅 Daily Distribution">
                    <Grid Margin="4">
                        <Border Background="{DynamicResource Theme.CardBackground}"
                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <DataGrid x:Name="DailyDistributionDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding FormattedDate}" Width="130"/>
                                    <DataGridTextColumn Header="Day" Binding="{Binding DayOfWeekName}" Width="90"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="100"/>
                                    <DataGridTextColumn Header="Hours" Binding="{Binding TotalHours, StringFormat=\{0:F2\} hrs}" Width="85"/>
                                    <DataGridTextColumn Header="Sessions" Binding="{Binding EntryCount}" Width="65"/>
                                    <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 3: Recorded Sessions Log -->
                <TabItem Header="📋 Sessions Log">
                    <Grid Margin="4">
                        <Border Background="{DynamicResource Theme.CardBackground}"
                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <DataGrid x:Name="SessionsLogDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding FormattedDate}" Width="95"/>
                                    <DataGridTextColumn Header="Time" Binding="{Binding FormattedTimeRange}" Width="105"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding FormattedDuration}" Width="85"/>
                                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="110"/>
                                    <DataGridTextColumn Header="Activity" Binding="{Binding Activity}" Width="100"/>
                                    <DataGridTextColumn Header="Task / Description" Binding="{Binding Description}" Width="140"/>
                                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 3: Action Footer -->
            <Grid Grid.Row="3" Margin="0 4 0 0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="NavigateBreakdownButton"
                            Content="📊 Go to Breakdown Tab"
                            Style="{DynamicResource GhostButton}"
                            Height="32"
                            Padding="12 0"
                            Margin="0 0 8 0"
                            Click="NavigateBreakdownButton_Click"/>
                    <Button x:Name="FilterWorkLogButton"
                            Content="📋 Filter in Work Log"
                            Style="{DynamicResource GhostButton}"
                            Height="32"
                            Padding="12 0"
                            Click="FilterWorkLogButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close"
                            Width="80"
                            Height="32"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>