<Window x:Class="VitorsWeeklyWorkTracking.WelcomeBackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome Back!"
        Icon="VitorWeeklyWorkTracking.ico"
        Width="570"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.Foreground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content / Goals & Milestones -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="GreetingTextBlock"
                               Text="👋 Welcome back!"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Foreground}"/>
                    <TextBlock x:Name="DateTextBlock"
                               Text="Tuesday, 29 September 2026"
                               FontSize="12"
                               Foreground="{DynamicResource Theme.ForegroundMuted}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="✨"
                           FontSize="32"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
                <!-- 1. Milestone Reminders Section -->
                <Border x:Name="MilestonesPanel"
                        Background="{DynamicResource Theme.CardBackground}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12 10"
                        Margin="0 0 0 10"
                        Visibility="Visible">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0 0 0 8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚩" FontSize="13" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                <TextBlock Text="Project Milestones &amp; Deadlines"
                                           FontWeight="Bold"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource Theme.Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="MilestonesCountTextBlock"
                                       Grid.Column="1"
                                       Text="0 upcoming"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Primary}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Milestones Items List -->
                        <ItemsControl x:Name="MilestonesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Theme.CardBackgroundAlt}"
                                            BorderBrush="{DynamicResource Theme.CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10 7"
                                            Margin="0 3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Project Color Indicator Dot -->
                                            <Border Grid.Column="0"
                                                    Width="10"
                                                    Height="10"
                                                    CornerRadius="5"
                                                    Background="{Binding ProjectBrush}"
                                                    Margin="0 0 8 0"
                                                    VerticalAlignment="Center"/>

                                            <!-- Milestone Title & Project -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0 0 8 0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="Bold"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource Theme.Foreground}"/>
                                                    <TextBlock Text=" • "
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                                    <TextBlock Text="{Binding ProjectName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DailyReminderText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding UrgencyBadgeBrush}"
                                                           Margin="0 2 0 0"/>
                                            </StackPanel>

                                            <!-- Urgency / Countdown Badge -->
                                            <Border Grid.Column="2"
                                                    Background="{Binding UrgencyBadgeBackground}"
                                                    BorderBrush="{Binding UrgencyBadgeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="8 3"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UrgencyBadgeText}"
                                                           FontWeight="Bold"
                                                           FontSize="10.5"
                                                           Foreground="{Binding UrgencyBadgeBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 2. Has Goals View -->
                <Border x:Name="GoalsPanel"
                        Background="{DynamicResource Theme.CardBackground}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12 10"
                        Margin="0 0 0 10"
                        Visibility="Visible">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0 0 0 8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎯" FontSize="13" Margin="0 0 5 0" VerticalAlignment="Center"/>
                                <TextBlock Text="Today's Scheduled Goals"
                                           FontWeight="Bold"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource Theme.Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TotalPlannedTextBlock"
                                       Grid.Column="1"
                                       Text="Total: 0.0 hrs"
                                       FontWeight="Bold"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Theme.Primary}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Goals List -->
                        <ItemsControl x:Name="GoalsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Theme.CardBackgroundAlt}"
                                            BorderBrush="{DynamicResource Theme.CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10 7"
                                            Margin="0 3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📌 " FontSize="12"/>
                                                    <TextBlock Text="{Binding ProjectName}"
                                                               FontWeight="Bold"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource Theme.Foreground}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Note}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Theme.ForegroundMuted}"
                                                           Margin="18,2,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasNoteVisibility}"/>
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource Theme.Primary}"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedDuration}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 3. No Goals / Free Day Card (shown if no scheduled goals for today) -->
                <Border x:Name="NoGoalsPanel"
                        Background="{DynamicResource Theme.CardBackground}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0 0 0 10"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="☕" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="No scheduled jobs for today!"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Foreground}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="You don't have any specific goals planned on the calendar yet. Enjoy a flexible day or set up today's work schedule anytime."
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Theme.ForegroundMuted}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="380"
                                   Margin="0,0,0,10"/>
                        <Button Content="📅 Plan Today's Goals"
                                Style="{StaticResource GhostButton}"
                                Padding="12,5"
                                HorizontalAlignment="Center"
                                Click="PlanDayButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Motivation Tip Card -->
                <Border Background="{DynamicResource Theme.CardBackgroundAlt}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10 8"
                        Margin="0 2 0 0">
                    <TextBlock x:Name="MotivationTextBlock"
                               Text="💡 Ready to tackle the day? Pick a goal, start the timer, and let's make great progress!"
                               FontSize="11"
                               Foreground="{DynamicResource Theme.ForegroundMuted}"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="OpenPlannerButton"
                    Content="📅 Open Planner"
                    Style="{StaticResource GhostButton}"
                    Padding="14,7"
                    Click="OpenPlannerButton_Click"/>

            <Button Grid.Column="2"
                    Content="🚀 Let's Get Started!"
                    Style="{StaticResource PrimaryButton}"
                    Padding="20,7"
                    FontWeight="Bold"
                    Click="StartButton_Click"/>
        </Grid>
    </Grid>
</Window>
