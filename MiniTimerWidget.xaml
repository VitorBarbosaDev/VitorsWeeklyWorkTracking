<Window x:Class="VitorsWeeklyWorkTracking.MiniTimerWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Work Timer"
        Width="300"
        Height="165"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{DynamicResource Theme.CardBackground}"
            BorderBrush="{DynamicResource Theme.CardBorder}"
            BorderThickness="1.5"
            CornerRadius="12"
            Margin="6"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.4"/>
        </Border.Effect>
        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <!-- Row 0: Header with status dot, title, corner switcher, restore button, close -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Digital Timer & Count mode toggle -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Goal progress bar (if active) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Project / Activity Info & Quick Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Top mini bar -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="MiniStatusDot" Width="8" Height="8" Fill="{DynamicResource Theme.ForegroundMuted}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="MiniStatusText" Text="READY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Switch Corner button -->
                    <Button x:Name="CornerSwitchButton"
                            Content="📍 Flip Corner"
                            ToolTip="Switch Corner (Bottom-Right ↔ Bottom-Left)"
                            Style="{StaticResource GhostButton}"
                            Padding="5,1"
                            Height="20"
                            FontSize="10"
                            Margin="0,0,4,0"
                            Click="CornerSwitchButton_Click"/>
                    <!-- Restore MainWindow button -->
                    <Button x:Name="RestoreButton"
                            Content="↗ Maximize"
                            ToolTip="Restore Main Window"
                            Style="{StaticResource GhostButton}"
                            Padding="5,1"
                            Height="20"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="0,0,4,0"
                            Click="RestoreButton_Click"/>
                    <!-- Close / Hide Mini Widget -->
                    <Button x:Name="CloseMiniButton"
                            Content="✕"
                            ToolTip="Close Mini Timer Overlay"
                            Style="{StaticResource GhostButton}"
                            Padding="5,1"
                            Height="20"
                            FontSize="10"
                            Click="CloseMiniButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Big Digital Clock & Mode Indicator -->
            <Grid Grid.Row="1" Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="MiniTimerText"
                           Text="00:00:00"
                           FontFamily="Consolas, Segoe UI, sans-serif"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Foreground}"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           ToolTip="Click to toggle Count Up / Count Down mode"
                           MouseLeftButtonUp="MiniTimerText_MouseLeftButtonUp"/>

                <Button x:Name="MiniTimerModeButton"
                        Grid.Column="1"
                        Content="⏱ UP"
                        ToolTip="Toggle Count Up / Count Down mode"
                        Style="{StaticResource GhostButton}"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Padding="6,2"
                        Height="22"
                        VerticalAlignment="Center"
                        Click="MiniTimerModeButton_Click"/>
            </Grid>

            <!-- Row 2: Goal Progress Bar (collapsible) -->
            <Grid x:Name="MiniGoalContainer" Grid.Row="2" Margin="0,2,0,4" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar x:Name="MiniGoalProgressBar" Height="5" Margin="0,0,0,2"/>
                <TextBlock x:Name="MiniGoalStatsText"
                           Grid.Row="1"
                           Text="45% • 15m left"
                           FontSize="9"
                           Foreground="{DynamicResource Theme.ForegroundMuted}"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- Row 3: Project / Activity Info & Quick Start/Stop -->
            <Grid Grid.Row="3" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock x:Name="MiniProjectText"
                               Text="Unassigned Project"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Foreground="{DynamicResource Theme.Foreground}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="170"/>
                    <TextBlock x:Name="MiniActivityText"
                               Text="No Activity"
                               FontSize="10"
                               Foreground="{DynamicResource Theme.ForegroundMuted}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="170"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MiniStartButton"
                            Content="▶ Start"
                            Style="{StaticResource SuccessButton}"
                            Height="24"
                            Padding="8,0"
                            FontSize="10"
                            FontWeight="Bold"
                            Click="MiniStartButton_Click"/>
                    <Button x:Name="MiniStopButton"
                            Content="⏹ Stop"
                            Style="{StaticResource DangerButton}"
                            Height="24"
                            Padding="8,0"
                            FontSize="10"
                            FontWeight="Bold"
                            Visibility="Collapsed"
                            Click="MiniStopButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
