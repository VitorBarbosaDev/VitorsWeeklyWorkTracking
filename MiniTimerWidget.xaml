<Window x:Class="VitorsWeeklyWorkTracking.MiniTimerWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VitorsWeeklyWorkTracking.Controls"
        Title="Mini Work Timer"
        Width="330"
        Height="265"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{DynamicResource Theme.CardBackground}"
            BorderBrush="{DynamicResource Theme.CardBorder}"
            BorderThickness="1.5"
            CornerRadius="12"
            Margin="6"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.4"/>
        </Border.Effect>
        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <!-- Row 0: Header with status dot, title, pin on top, corner switcher, restore, close -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Optional Alert Toast Banner -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Digital Timer & Count mode toggle -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Mini Visual Animated Companion Box OR Mini Retro ASCII Box -->
                <RowDefinition Height="Auto"/>
                <!-- Row 4: Mini Narrative / Status Line -->
                <RowDefinition Height="Auto"/>
                <!-- Row 5: Goal progress bar (if active) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 6: Project / Activity Info & Quick Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Top mini bar -->
            <Grid Grid.Row="0" Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="MiniStatusDot" Width="8" Height="8" Fill="{DynamicResource Theme.ForegroundMuted}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="MiniStatusText" Text="READY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    
                    <!-- Always On Top Pin Button -->
                    <Button x:Name="PinOnTopButton"
                            Content="📌 Pinned"
                            ToolTip="Always on Top (Draws above all applications)"
                            Style="{StaticResource GhostButton}"
                            Padding="5,1"
                            Height="20"
                            FontSize="10"
                            Margin="0,0,4,0"
                            Click="PinOnTopButton_Click"/>

                    <!-- Switch Corner button -->
                    <Button x:Name="CornerSwitchButton"
                            Content="📍 Flip"
                            ToolTip="Switch Corner (Bottom-Right ↔ Bottom-Left)"
                            Style="{StaticResource GhostButton}"
                            Padding="5,1"
                            Height="20"
                            FontSize="10"
                            Margin="0,0,4,0"
                            Click="CornerSwitchButton_Click"/>

                    <!-- Restore MainWindow button -->
                    <Button x:Name="RestoreButton"
                            Content="↗ Maximize"
                            ToolTip="Restore Main Window"
                            Style="{StaticResource GhostButton}"
                            Padding="5,1"
                            Height="20"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="0,0,4,0"
                            Click="RestoreButton_Click"/>

                    <!-- Close / Hide Mini Widget -->
                    <Button x:Name="CloseMiniButton"
                            Content="✕"
                            ToolTip="Close Mini Timer Overlay"
                            Style="{StaticResource GhostButton}"
                            Padding="5,1"
                            Height="20"
                            FontSize="10"
                            Click="CloseMiniButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Optional Alert Toast Banner -->
            <Border x:Name="MiniAlertBanner"
                    Grid.Row="1"
                    Background="{DynamicResource Theme.CardBackgroundAlt}"
                    BorderBrush="{DynamicResource Theme.Primary}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6,3"
                    Margin="0,2,0,4"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    ToolTip="Click to dismiss alert"
                    MouseLeftButtonUp="MiniAlertBanner_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MiniAlertText"
                               Text="🔔 Rest Time! Take a break &amp; stretch!"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Primary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="✕" FontSize="9" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="4,0,0,0"/>
                </Grid>
            </Border>

            <!-- Row 2: Big Digital Clock & Mode Indicator -->
            <Grid Grid.Row="2" Margin="0,1,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="MiniTimerText"
                           Text="00:00:00"
                           FontFamily="Consolas, Segoe UI, sans-serif"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Theme.Foreground}"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           ToolTip="Click to toggle Count Up / Count Down mode"
                           MouseLeftButtonUp="MiniTimerText_MouseLeftButtonUp"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Art Mode switcher (Graphics / ASCII) -->
                    <Button x:Name="MiniArtModeButton"
                            Content="🎨"
                            ToolTip="Switch Art Mode (Graphics ↔ ASCII)"
                            Style="{StaticResource GhostButton}"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Padding="6,2"
                            Height="22"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Click="MiniArtModeButton_Click"/>
                
                    <!-- Timer Count Up / Down Toggle -->
                    <Button x:Name="MiniTimerModeButton"
                            Content="⏱ UP"
                            ToolTip="Toggle Count Up / Count Down mode"
                            Style="{StaticResource GhostButton}"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Padding="6,2"
                            Height="22"
                            VerticalAlignment="Center"
                            Click="MiniTimerModeButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Row 3: Mini Visual Animated Companion Graphic OR Mini Retro ASCII Box -->
            <Border x:Name="MiniVisualBorder"
                    Grid.Row="3"
                    Background="{DynamicResource Theme.CardBackgroundAlt}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Height="68"
                    Margin="0,1,0,3"
                    Cursor="Hand"
                    ToolTip="Click to cheer on companion!"
                    MouseLeftButtonUp="MiniVisualBorder_MouseLeftButtonUp">
                <local:VisualCompanionControl x:Name="MiniVisualCompanion" IsMiniMode="True"/>
            </Border>

            <Border x:Name="MiniAsciiBorder"
                    Grid.Row="3"
                    Background="{DynamicResource Theme.CardBackgroundAlt}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Height="68"
                    Padding="6,3"
                    Margin="0,1,0,3"
                    Cursor="Hand"
                    ToolTip="Click to cheer on companion!"
                    Visibility="Collapsed"
                    MouseLeftButtonUp="MiniAsciiBorder_MouseLeftButtonUp">
                <TextBlock x:Name="MiniAsciiText"
                           FontFamily="Consolas, Lucida Console, Courier New, monospace"
                           FontSize="8.5"
                           LineHeight="11"
                           Foreground="{DynamicResource Theme.Foreground}"
                           TextWrapping="NoWrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Row 4: Mini Narrative Text Line -->
            <TextBlock x:Name="MiniCompanionLine"
                       Grid.Row="4"
                       Text="🚴 Boy is pedaling towards home..."
                       FontSize="9.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.Primary}"
                       Margin="0,0,0,2"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Row 5: Goal progress bar (collapsible) -->
            <Grid x:Name="MiniGoalContainer" Grid.Row="5" Margin="0,1,0,3" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar x:Name="MiniGoalProgressBar" Height="4" Margin="0,0,0,2"/>
                <TextBlock x:Name="MiniGoalStatsText"
                           Grid.Row="1"
                           Text="45% • 15m left"
                           FontSize="9"
                           Foreground="{DynamicResource Theme.ForegroundMuted}"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- Row 6: Project / Activity Info & Quick Start/Stop -->
            <Grid Grid.Row="6" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock x:Name="MiniProjectText"
                               Text="Unassigned Project"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Foreground="{DynamicResource Theme.Foreground}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="170"/>
                    <TextBlock x:Name="MiniActivityText"
                               Text="No Activity"
                               FontSize="10"
                               Foreground="{DynamicResource Theme.ForegroundMuted}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="170"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MiniStartButton"
                            Content="▶ Start"
                            Style="{StaticResource SuccessButton}"
                            Height="24"
                            Padding="8,0"
                            FontSize="10"
                            FontWeight="Bold"
                            Click="MiniStartButton_Click"/>
                    <Button x:Name="MiniStopButton"
                            Content="⏹ Stop"
                            Style="{StaticResource DangerButton}"
                            Height="24"
                            Padding="8,0"
                            FontSize="10"
                            FontWeight="Bold"
                            Visibility="Collapsed"
                            Click="MiniStopButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
