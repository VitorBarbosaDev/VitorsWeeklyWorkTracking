<Window x:Class="VitorsWeeklyWorkTracking.WorkRestSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Work &amp; Rest Interval Settings"
        Icon="VitorWeeklyWorkTracking.ico"
        Width="460"
        Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.Foreground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙️ Work &amp; Rest Interval Settings"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Theme.Foreground}"/>
            <TextBlock Text="Configure structured work sprints and relaxing rest breaks with friendly alerts."
                       FontSize="11"
                       Foreground="{DynamicResource Theme.ForegroundMuted}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Preset Selector -->
                <Border Background="{DynamicResource Theme.CardBackground}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📋 Focus &amp; Rest Presets" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Foreground}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PresetComboBox"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="PresetComboBox_SelectionChanged"/>
                        <TextBlock x:Name="PresetDescriptionText"
                                   Text="Classic Pomodoro cycle: 25 minutes of high focus followed by 5 minutes of rest."
                                   FontSize="11"
                                   Foreground="{DynamicResource Theme.ForegroundMuted}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Interval Durations Card -->
                <Border Background="{DynamicResource Theme.CardBackground}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="⏱️ Custom Interval Durations" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Foreground}" Margin="0,0,0,10"/>

                        <!-- Focus Duration -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🎯 Focus Duration:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            <Slider x:Name="FocusSlider" Grid.Column="1" Minimum="5" Maximum="120" SmallChange="1" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                            <TextBlock x:Name="FocusValueText" Grid.Column="2" Text="25 min" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Primary}"/>
                        </Grid>

                        <!-- Short Break Duration -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="☕ Short Rest Break:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            <Slider x:Name="ShortBreakSlider" Grid.Column="1" Minimum="1" Maximum="30" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                            <TextBlock x:Name="ShortBreakValueText" Grid.Column="2" Text="5 min" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Success}"/>
                        </Grid>

                        <!-- Long Break Duration -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🛋️ Long Rest Break:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            <Slider x:Name="LongBreakSlider" Grid.Column="1" Minimum="5" Maximum="60" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                            <TextBlock x:Name="LongBreakValueText" Grid.Column="2" Text="15 min" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Warning}"/>
                        </Grid>

                        <!-- Cycles Before Long Break -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔄 Cycles before Long Break:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            <Slider x:Name="CyclesSlider" Grid.Column="1" Minimum="2" Maximum="8" SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                            <TextBlock x:Name="CyclesValueText" Grid.Column="2" Text="4 cycles" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Preferences Card -->
                <Border Background="{DynamicResource Theme.CardBackground}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="🔔 Alert &amp; Transition Options" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Foreground}" Margin="0,0,0,8"/>

                        <CheckBox x:Name="SoundAlertCheckBox"
                                  Content="🔔 Play pleasant audio chime when Rest or Focus starts"
                                  IsChecked="True"
                                  Margin="0,0,0,8"/>

                        <CheckBox x:Name="AutoAdvanceCheckBox"
                                  Content="⏩ Automatically advance to next phase when timer finishes"
                                  IsChecked="False"
                                  Margin="0,0,0,8"/>

                        <CheckBox x:Name="CompanionVisibleCheckBox"
                                  Content="🎨 Show animated ASCII / Pixel art companion"
                                  IsChecked="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    Style="{StaticResource GhostButton}"
                    Padding="16,6"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"/>

            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Content="Save Settings"
                    Style="{StaticResource PrimaryButton}"
                    Padding="18,6"
                    Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
