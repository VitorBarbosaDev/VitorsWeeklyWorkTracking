<Window x:Class="VitorsWeeklyWorkTracking.WorkRestSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Work &amp; Rest Interval Settings"
        Icon="VitorWeeklyWorkTracking.ico"
        Width="510"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.Foreground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙️ Work &amp; Rest Interval Settings"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Theme.Foreground}"/>
            <TextBlock Text="Configure structured work sprints and relaxing rest breaks with friendly alerts."
                       FontSize="11"
                       Foreground="{DynamicResource Theme.ForegroundMuted}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- User Profile & Daily Greeting Card -->
                <Border Background="{DynamicResource Theme.CardBackground}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="👤 User Profile &amp; Daily Welcome" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Foreground}" Margin="0,0,0,8"/>
                        <TextBlock Text="Personalize your daily experience and welcome popup greeting on first launch."
                                   FontSize="11"
                                   Foreground="{DynamicResource Theme.ForegroundMuted}"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Your Name (Optional):" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBox x:Name="UserNameTextBox"
                                     Grid.Column="1"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     Padding="6,2"
                                     ToolTip="Enter your name to personalize daily welcome messages and greetings"/>
                            <Button x:Name="PreviewWelcomeButton"
                                    Grid.Column="2"
                                    Content="👁️ Preview Greeting"
                                    Style="{StaticResource GhostButton}"
                                    Height="28"
                                    Padding="8,0"
                                    Margin="8,0,0,0"
                                    FontSize="11"
                                    ToolTip="Preview what today's welcome popup looks like"
                                    Click="PreviewWelcomeButton_Click"/>
                        </Grid>

                        <CheckBox x:Name="WelcomePopupEnabledCheckBox"
                                  Content="👋 Show Welcome Back popup with scheduled daily goals on first launch of the day"
                                  IsChecked="True"
                                  Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Master Toggle Card -->
                <Border Background="{DynamicResource Theme.CardBackground}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="IntervalModeEnabledCheckBox"
                                  Content="🍅 Enable Pomodoro / Interval Mode (Work &amp; Rest Cycles)"
                                  FontWeight="Bold"
                                  FontSize="13"
                                  Foreground="{DynamicResource Theme.Primary}"
                                  IsChecked="True"/>
                        <TextBlock Text="When enabled, time tracking runs in structured focus sprints with break reminders. When disabled, you can track continuous time with no interruptions."
                                   FontSize="11"
                                   Foreground="{DynamicResource Theme.ForegroundMuted}"
                                   Margin="24,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Preset Selector -->
                <Border Background="{DynamicResource Theme.CardBackground}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📋 Focus &amp; Rest Presets" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Foreground}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PresetComboBox"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="PresetComboBox_SelectionChanged"/>
                        <TextBlock x:Name="PresetDescriptionText"
                                   Text="Classic Pomodoro cycle: 25 minutes of high focus followed by 5 minutes of rest."
                                   FontSize="11"
                                   Foreground="{DynamicResource Theme.ForegroundMuted}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Interval Durations Card -->
                <Border Background="{DynamicResource Theme.CardBackground}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="⏱️ Custom Interval Durations" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Foreground}" Margin="0,0,0,10"/>

                        <!-- Focus Duration -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🎯 Focus Duration:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            <Slider x:Name="FocusSlider" Grid.Column="1" Minimum="5" Maximum="120" SmallChange="1" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                            <TextBlock x:Name="FocusValueText" Grid.Column="2" Text="25 min" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Primary}"/>
                        </Grid>

                        <!-- Short Break Duration -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="☕ Short Rest Break:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            <Slider x:Name="ShortBreakSlider" Grid.Column="1" Minimum="1" Maximum="30" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                            <TextBlock x:Name="ShortBreakValueText" Grid.Column="2" Text="5 min" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Success}"/>
                        </Grid>

                        <!-- Long Break Duration -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🛋️ Long Rest Break:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            <Slider x:Name="LongBreakSlider" Grid.Column="1" Minimum="5" Maximum="60" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                            <TextBlock x:Name="LongBreakValueText" Grid.Column="2" Text="15 min" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Warning}"/>
                        </Grid>

                        <!-- Cycles Before Long Break -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔄 Cycles before Long Break:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            <Slider x:Name="CyclesSlider" Grid.Column="1" Minimum="2" Maximum="8" SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                            <TextBlock x:Name="CyclesValueText" Grid.Column="2" Text="4 cycles" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Audio & Sound Effects Card -->
                <Border Background="{DynamicResource Theme.CardBackground}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="SoundAlertCheckBox"
                                  Content="🔊 Enable Sound Effects"
                                  FontWeight="Bold"
                                  FontSize="13"
                                  Foreground="{DynamicResource Theme.Primary}"
                                  IsChecked="True"
                                  Checked="SoundAlertCheckBox_Changed"
                                  Unchecked="SoundAlertCheckBox_Changed"/>

                        <!-- Volume & Event Sounds Group -->
                        <Border x:Name="SoundControlsContainer"
                                Background="{DynamicResource Theme.CardBackgroundAlt}"
                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <!-- Master Volume Slider -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔊 Volume:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="10" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                                    <TextBlock x:Name="VolumeValueText" Grid.Column="2" Text="75%" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Foreground}"/>
                                    <Button x:Name="TestVolumeButton" Grid.Column="3" Content="▶ Test" Style="{StaticResource GhostButton}" Padding="8,2" Margin="8,0,0,0" Height="24" FontSize="11" ToolTip="Test audio volume" Click="TestVolumeButton_Click"/>
                                </Grid>

                                <Separator Background="{DynamicResource Theme.CardBorder}" Margin="0,2,0,8"/>

                                <TextBlock Text="Toggle sound events and their variations. When an event triggers, a random variation from its enabled choices will play:"
                                           FontSize="11"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource Theme.ForegroundMuted}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <!-- 1. On Session Start Group -->
                                <Border Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="SoundOnStartCheckBox"
                                                      Content="▶ On Session Start"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      IsChecked="True"
                                                      Checked="SoundEventToggle_Changed"
                                                      Unchecked="SoundEventToggle_Changed"/>
                                            <Button Tag="Start"
                                                    Grid.Column="1"
                                                    Content="🎲 Test Random"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="8,2"
                                                    Height="22"
                                                    FontSize="10.5"
                                                    ToolTip="Preview a random enabled start variation"
                                                    Click="TestEventButton_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="StartVariationsPanel" Margin="22,6,0,0">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_start_ascending" Content="🎵 Ascending Chime (C5 → E5 → G5)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="start_ascending" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_start_pop" Content="✨ Quick Pop-Brite (G5 → C6)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="start_pop" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_start_marimba" Content="🪵 Warm Marimba (A4 → C#5 → E5 → A5)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="start_marimba" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_start_digital" Content="⚡ Digital Power-Up (D5 → F#5 → A5 → D6)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="start_digital" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 2. On Session End Group -->
                                <Border Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="SoundOnEndCheckBox"
                                                      Content="⏹ On Session End (Stop Tracking)"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      IsChecked="True"
                                                      Checked="SoundEventToggle_Changed"
                                                      Unchecked="SoundEventToggle_Changed"/>
                                            <Button Tag="End"
                                                    Grid.Column="1"
                                                    Content="🎲 Test Random"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="8,2"
                                                    Height="22"
                                                    FontSize="10.5"
                                                    ToolTip="Preview a random enabled session end variation"
                                                    Click="TestEventButton_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="EndVariationsPanel" Margin="22,6,0,0">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_end_completion" Content="🔔 Gentle Completion Bell (C6 → G5 → E5 → C5)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="end_completion" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_end_accomplished" Content="🏆 Mission Accomplished (E5 → A4)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="end_accomplished" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_end_sparkle" Content="✨ Sparkle Wind-Down (G5 → E5 → C5 → A4)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="end_sparkle" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_end_calm" Content="🌿 Calm Acoustic Chord (C4 + E4 + G4 + B4)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="end_calm" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 3. On Session Goal Achieved Group -->
                                <Border Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="SoundOnGoalCheckBox"
                                                      Content="🎯 On Session Goal Achieved"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      IsChecked="True"
                                                      Checked="SoundEventToggle_Changed"
                                                      Unchecked="SoundEventToggle_Changed"/>
                                            <Button Tag="GoalAchieved"
                                                    Grid.Column="1"
                                                    Content="🎲 Test Random"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="8,2"
                                                    Height="22"
                                                    FontSize="10.5"
                                                    ToolTip="Preview a random enabled goal fanfare variation"
                                                    Click="TestEventButton_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="GoalVariationsPanel" Margin="22,6,0,0">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_goal_victory" Content="🎉 Victory Fanfare (C5 → E5 → G5 → C6 → E6)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="goal_victory" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_goal_levelup" Content="🌟 Level-Up Triumph (D5 → F#5 → A5 → D6 → F#6)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="goal_levelup" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_goal_bell" Content="🔔 Golden Bell Melody (G5 → B5 → D6 → G6)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="goal_bell" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_goal_cosmic" Content="🪐 Cosmic Sparkles (E5 → G#5 → B5 → E6 → G#6)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="goal_cosmic" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 4. On Daily Work Goal Reached Group -->
                                <Border Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="SoundOnDailyGoalCheckBox"
                                                      Content="📅 On Daily Work Goal Reached (Planner 100%)"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      IsChecked="True"
                                                      Checked="SoundEventToggle_Changed"
                                                      Unchecked="SoundEventToggle_Changed"/>
                                            <Button Tag="DailyGoalAchieved"
                                                    Grid.Column="1"
                                                    Content="🎲 Test Random"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="8,2"
                                                    Height="22"
                                                    FontSize="10.5"
                                                    ToolTip="Preview a random enabled daily goal fanfare variation"
                                                    Click="TestEventButton_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="DailyGoalVariationsPanel" Margin="22,6,0,0">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_daily_triumph" Content="🏆 Daily Triumph Fanfare (C5 → E5 → G5 → C6 → E6 → G6)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="daily_triumph" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_daily_sunburst" Content="🌅 Sunburst Achievement (D4/A4 → D5 → F#5 → A5 → D6 → F#6)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="daily_sunburst" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_daily_chime" Content="🔔 Master Day Chimes (G5 → B5 → D6 → G6 → B6)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="daily_chime" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="Var_daily_quest" Content="🌟 Daily Quest Complete (E5 → G#5 → B5 → E6 → G#6 → B6 → E7)" FontSize="11" VerticalAlignment="Center" IsChecked="True"/>
                                                <Button Tag="daily_quest" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="24" Height="20" Padding="0" FontSize="10" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 5. On Weekly Work Goal Reached Group -->
                                <Border Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="SoundOnWeeklyGoalCheckBox"
                                                      Content="👑 On Weekly Work Goal Reached (Planner 100%)"
                                                      FontWeight="SemiBold"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      IsChecked="True"
                                                      Checked="SoundEventToggle_Changed"
                                                      Unchecked="SoundEventToggle_Changed"/>
                                            <Button Tag="WeeklyGoalAchieved"
                                                    Grid.Column="1"
                                                    Content="🎲 Test Random"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="8,2"
                                                    Height="22"
                                                    FontSize="10.5"
                                                    ToolTip="Preview a random enabled weekly goal fanfare variation"
                                                    Click="TestEventButton_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="WeeklyGoalVariationsPanel" Margin="22,6,0,0">
