                                            </Border>

                                            <!-- Rocket -->
                                            <Border Background="{DynamicResource Theme.Background}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="🚀 Space Rocket Launch" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                        <Button Tag="rocket" Grid.Column="1" Content="🎲 Test Scene" Style="{StaticResource GhostButton}" Height="18" Padding="6,0" FontSize="9.5" Click="TestSceneButton_Click"/>
                                                    </Grid>
                                                    <Grid Margin="6,0,0,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="Var_cheer_rocket_laser" Content="🚀 Cosmic Laser Boost (C6 → G6 → C7)" FontSize="10.5" VerticalAlignment="Center" IsChecked="True"/>
                                                        <Button Tag="cheer_rocket_laser" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="20" Height="18" Padding="0" FontSize="9.5" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                                    </Grid>
                                                    <Grid Margin="6,0,0,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="Var_cheer_rocket_beacon" Content="🪐 Satellite Radar Ping (A6 → E6 Echo)" FontSize="10.5" VerticalAlignment="Center" IsChecked="True"/>
                                                        <Button Tag="cheer_rocket_beacon" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="20" Height="18" Padding="0" FontSize="9.5" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                                    </Grid>
                                                    <Grid Margin="6,0,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="Var_cheer_rocket_warp" Content="✨ Hyperspace Warp Sweep (D5 → A5 → D6 → D7)" FontSize="10.5" VerticalAlignment="Center" IsChecked="True"/>
                                                        <Button Tag="cheer_rocket_warp" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="20" Height="18" Padding="0" FontSize="9.5" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Runner -->
                                            <Border Background="{DynamicResource Theme.Background}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="🏃 Chibi Marathon Runner" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                        <Button Tag="runner" Grid.Column="1" Content="🎲 Test Scene" Style="{StaticResource GhostButton}" Height="18" Padding="6,0" FontSize="9.5" Click="TestSceneButton_Click"/>
                                                    </Grid>
                                                    <Grid Margin="6,0,0,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="Var_cheer_runner_whistle" Content="🏃 Coach Sport Whistle (G6 Rapid Vibrato)" FontSize="10.5" VerticalAlignment="Center" IsChecked="True"/>
                                                        <Button Tag="cheer_runner_whistle" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="20" Height="18" Padding="0" FontSize="9.5" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                                    </Grid>
                                                    <Grid Margin="6,0,0,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="Var_cheer_runner_horn" Content="🎺 Stadium Victory Horn (C5 → E5 → G5 → C6)" FontSize="10.5" VerticalAlignment="Center" IsChecked="True"/>
                                                        <Button Tag="cheer_runner_horn" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="20" Height="18" Padding="0" FontSize="9.5" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                                    </Grid>
                                                    <Grid Margin="6,0,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="Var_cheer_runner_squeak" Content="👟 Sprint Sneaker Squeak (A5 → D6 → F#6)" FontSize="10.5" VerticalAlignment="Center" IsChecked="True"/>
                                                        <Button Tag="cheer_runner_squeak" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="20" Height="18" Padding="0" FontSize="9.5" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tamagotchi -->
                                            <Border Background="{DynamicResource Theme.Background}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="👾 Focus Pet Tamagotchi" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                        <Button Tag="tamagotchi" Grid.Column="1" Content="🎲 Test Scene" Style="{StaticResource GhostButton}" Height="18" Padding="6,0" FontSize="9.5" Click="TestSceneButton_Click"/>
                                                    </Grid>
                                                    <Grid Margin="6,0,0,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="Var_cheer_pet_happy" Content="👾 8-Bit Happy Chirp (C6 → E6 → G6 → C7)" FontSize="10.5" VerticalAlignment="Center" IsChecked="True"/>
                                                        <Button Tag="cheer_pet_happy" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="20" Height="18" Padding="0" FontSize="9.5" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                                    </Grid>
                                                    <Grid Margin="6,0,0,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="Var_cheer_pet_levelup" Content="🌟 Pixel Item Power-Up (F5 → A5 → C6 → F6)" FontSize="10.5" VerticalAlignment="Center" IsChecked="True"/>
                                                        <Button Tag="cheer_pet_levelup" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="20" Height="18" Padding="0" FontSize="9.5" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                                    </Grid>
                                                    <Grid Margin="6,0,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="Var_cheer_pet_heart" Content="💖 Pixel Pet Love Beep (G6 → C7)" FontSize="10.5" VerticalAlignment="Center" IsChecked="True"/>
                                                        <Button Tag="cheer_pet_heart" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="20" Height="18" Padding="0" FontSize="9.5" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Lumberjack Wood Chopping -->
                                            <Border Background="{DynamicResource Theme.Background}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,4,0,0">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="🪓 Lumberjack Wood Chopping" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                        <Button Tag="lumberjack" Grid.Column="1" Content="🎲 Test Scene" Style="{StaticResource GhostButton}" Height="18" Padding="6,0" FontSize="9.5" Click="TestSceneButton_Click"/>
                                                    </Grid>
                                                    <Grid Margin="6,0,0,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="Var_cheer_lumberjack_chop" Content="🪓 Axe Strike &amp; Splinter (E3 + A4 + E5)" FontSize="10.5" VerticalAlignment="Center" IsChecked="True"/>
                                                        <Button Tag="cheer_lumberjack_chop" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="20" Height="18" Padding="0" FontSize="9.5" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                                    </Grid>
                                                    <Grid Margin="6,0,0,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="Var_cheer_lumberjack_timber" Content="🌲 'Timber!' Forest Echo (G5 → E5 → C5)" FontSize="10.5" VerticalAlignment="Center" IsChecked="True"/>
                                                        <Button Tag="cheer_lumberjack_timber" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="20" Height="18" Padding="0" FontSize="9.5" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                                    </Grid>
                                                    <Grid Margin="6,0,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox x:Name="Var_cheer_lumberjack_van" Content="🚚 Timber Van Horn (F4 + A4 → C5 + F5)" FontSize="10.5" VerticalAlignment="Center" IsChecked="True"/>
                                                        <Button Tag="cheer_lumberjack_van" Grid.Column="1" Content="▶" Style="{StaticResource GhostButton}" Width="20" Height="18" Padding="0" FontSize="9.5" ToolTip="Preview variation" Click="TestVariationButton_Click"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Floating Mini Timer & Display Monitor Card -->
                <Border Background="{DynamicResource Theme.CardBackground}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🖥️ Floating Mini Timer &amp; Display Monitor" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Foreground}" Margin="0,0,0,8"/>
                        <TextBlock Text="Choose which monitor and screen corner the floating mini timer displays on by default when minimized."
                                   FontSize="11"
                                   Foreground="{DynamicResource Theme.ForegroundMuted}"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <!-- Target Monitor Selection -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🖥️ Default Monitor:" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                            <ComboBox x:Name="MiniMonitorComboBox"
                                      Grid.Column="1"
                                      DisplayMemberPath="DisplayName"/>
                        </Grid>

                        <!-- Default Screen Corner Selection -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📍 Default Corner:" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/>
                            <ComboBox x:Name="MiniCornerComboBox" Grid.Column="1">
                                <ComboBoxItem Content="↘ Bottom-Right (Standard)"/>
                                <ComboBoxItem Content="↙ Bottom-Left"/>
                                <ComboBoxItem Content="↗ Top-Right"/>
                                <ComboBoxItem Content="↖ Top-Left"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="MiniTimerEnabledCheckBox"
                                  Content="🗗 Show floating mini timer overlay when main window is minimized"
                                  IsChecked="True"
                                  Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <!-- Preferences Card -->
                <Border Background="{DynamicResource Theme.CardBackground}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="⚙️ Transition &amp; Companion Options" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Foreground}" Margin="0,0,0,8"/>

                        <CheckBox x:Name="AutoAdvanceCheckBox"
                                  Content="⏩ Automatically advance to next session (Work → Break → Work → Break)"
                                  ToolTip="When enabled, automatically transitions between Focus sprints and Rest breaks (Work → Break → Work → Break) when each timer finishes."
                                  IsChecked="False"
                                  Margin="0,0,0,8"/>

                        <CheckBox x:Name="CompanionVisibleCheckBox"
                                  Content="🎨 Show animated ASCII / Pixel art companion"
                                  IsChecked="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    Style="{StaticResource GhostButton}"
                    Padding="16,6"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"/>

            <Button x:Name="SaveButton"
                    Grid.Column="2"
                    Content="Save Settings"
                    Style="{StaticResource PrimaryButton}"
                    Padding="18,6"
                    Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
