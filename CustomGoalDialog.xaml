<Window x:Class="VitorsWeeklyWorkTracking.CustomGoalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Custom Goal"
        Icon="VitorWeeklyWorkTracking.ico"
        Width="360"
        Height="270"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0 0 0 14">
                <TextBlock Text="🎯 Custom Session Goal" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}"/>
                <TextBlock Text="Set a target duration in minutes for your work session" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 2 0 0"/>
            </StackPanel>

            <!-- Input row -->
            <Grid Grid.Row="1" Margin="0 0 0 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MinutesTextBox"
                         Height="34"
                         FontSize="14"
                         FontWeight="SemiBold"
                         VerticalContentAlignment="Center"
                         PreviewTextInput="MinutesTextBox_PreviewTextInput"
                         KeyDown="MinutesTextBox_KeyDown"/>
                <TextBlock Grid.Column="1" Text="Minutes" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8 0 0 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
            </Grid>

            <!-- Quick Preset Chips -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 0 0 16">
                <TextBlock Text="Quick:" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" VerticalAlignment="Center" Margin="0 0 6 0"/>
                <Button Content="10m" Style="{StaticResource GhostButton}" Padding="6 2" Margin="0 0 4 0" FontSize="11" Click="QuickPreset_Click" Tag="10"/>
                <Button Content="20m" Style="{StaticResource GhostButton}" Padding="6 2" Margin="0 0 4 0" FontSize="11" Click="QuickPreset_Click" Tag="20"/>
                <Button Content="50m" Style="{StaticResource GhostButton}" Padding="6 2" Margin="0 0 4 0" FontSize="11" Click="QuickPreset_Click" Tag="50"/>
                <Button Content="75m" Style="{StaticResource GhostButton}" Padding="6 2" Margin="0 0 4 0" FontSize="11" Click="QuickPreset_Click" Tag="75"/>
                <Button Content="90m" Style="{StaticResource GhostButton}" Padding="6 2" Margin="0 0 4 0" FontSize="11" Click="QuickPreset_Click" Tag="90"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Cancel"
                        Width="80"
                        Height="30"
                        Margin="0 0 8 0"
                        Click="CancelButton_Click"/>
                <Button Content="Set Goal"
                        Style="{StaticResource PrimaryButton}"
                        Width="90"
                        Height="30"
                        Click="SetGoalButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
