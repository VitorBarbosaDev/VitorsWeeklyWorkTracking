<Window x:Class="VitorsWeeklyWorkTracking.BackupManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup &amp; Restore Data"
        Icon="VitorWeeklyWorkTracking.ico"
        Height="620"
        Width="820"
        MinHeight="520"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Action Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Main Content (List + Details) -->
            <RowDefinition Height="*"/>
            <!-- 3: Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header Area -->
        <Border Grid.Row="0"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16 12"
                Margin="0 0 0 12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="40"
                        Height="40"
                        CornerRadius="8"
                        Background="#1E293B"
                        Margin="0 0 12 0"
                        VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Backup &amp; Restore Manager" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}"/>
                    <TextBlock Text="Create snapshots before updates and easily restore old data if anything was incorrectly changed" FontSize="11.5" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 2 0 0"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{DynamicResource Theme.CardBackgroundAlt}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10 6"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderStatsTextBlock"
                               Text="0 backups available"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                </Border>
            </Grid>
        </Border>

        <!-- 1. Action Toolbar -->
        <Border Grid.Row="1"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10 8"
                Margin="0 0 0 12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CreateBackupButton"
                            Content="➕ Create Backup"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12 5"
                            Margin="0 0 6 0"
                            ToolTip="Create a new manual backup snapshot of all current data"
                            Click="CreateBackupButton_Click"/>

                    <Button x:Name="RestoreSelectedButton"
                            Content="🔄 Restore Selected"
                            Style="{StaticResource SuccessButton}"
                            Padding="12 5"
                            Margin="0 0 6 0"
                            ToolTip="Restore data from the highlighted backup snapshot"
                            Click="RestoreSelectedButton_Click"/>

                    <Button x:Name="ExportBackupButton"
                            Content="📤 Export (.zip)"
                            Style="{StaticResource GhostButton}"
                            Padding="10 5"
                            Margin="0 0 6 0"
                            ToolTip="Export selected backup or current live data to a .zip archive file"
                            Click="ExportBackupButton_Click"/>

                    <Button x:Name="ImportBackupButton"
                            Content="📥 Import (.zip)"
                            Style="{StaticResource GhostButton}"
                            Padding="10 5"
                            Margin="0 0 6 0"
                            ToolTip="Import an external backup from a .zip file"
                            Click="ImportBackupButton_Click"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenFolderButton"
                            Content="📂 Open Folder"
                            Style="{StaticResource GhostButton}"
                            Padding="10 5"
                            Margin="0 0 6 0"
                            ToolTip="Open backups folder in Windows Explorer"
                            Click="OpenFolderButton_Click"/>

                    <Button x:Name="DeleteBackupButton"
                            Content="🗑️ Delete"
                            Style="{StaticResource GhostDangerButton}"
                            Padding="10 5"
                            ToolTip="Delete the selected backup snapshot"
                            Click="DeleteBackupButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Content (List + Details Pane) -->
        <Grid Grid.Row="2" Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Backups List -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0 0 8 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter / Title -->
                    <Grid Grid.Row="0" Margin="0 0 0 8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📋 Backup History" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme.Foreground}" VerticalAlignment="Center"/>

                        <TextBox x:Name="SearchFilterTextBox"
                                 Grid.Column="1"
                                 Margin="12 0 6 0"
                                 Padding="6 3"
                                 FontSize="11.5"
                                 VerticalAlignment="Center"
                                 ToolTip="Filter backups by reason or note"
                                 TextChanged="SearchFilterTextBox_TextChanged"/>

                        <Button Grid.Column="2"
                                Content="🔄"
                                Style="{StaticResource GhostButton}"
                                Padding="6 3"
                                ToolTip="Refresh backup list"
                                Click="RefreshButton_Click"/>
                    </Grid>

                    <!-- Backups ListBox -->
                    <ListBox x:Name="BackupsListBox"
                             Grid.Row="1"
                             SelectionChanged="BackupsListBox_SelectionChanged"
                             MouseDoubleClick="BackupsListBox_MouseDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4 6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 0: Badge & Title -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="4"
                                                Padding="6 2"
                                                Margin="0 0 6 0"
                                                Background="{Binding BadgeBackgroundHex}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BadgeText}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Theme.Foreground}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Row 0 Right: Timestamp -->
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding FormattedCreatedAt}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Theme.ForegroundMuted}"
                                               VerticalAlignment="Center"/>

                                    <!-- Row 1: Summary Stats -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding SummaryText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Theme.ForegroundMuted}"
                                               Margin="0 3 0 0"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State -->
                    <Border x:Name="EmptyStateBorder"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🛡️" FontSize="26" HorizontalAlignment="Center" Margin="0 0 0 6" Opacity="0.5"/>
                            <TextBlock Text="No backups found" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click 'Create Backup' above to create your first snapshot" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center" Margin="0 2 0 0" Opacity="0.8"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Details Pane -->
            <Border Grid.Column="1"
                    Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="8 0 0 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🔍 Selected Backup" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme.Foreground}" Margin="0 0 0 10"/>

                    <!-- Details Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailsPanel" Visibility="Visible">
                            <!-- Metadata Card -->
                            <Border Background="{DynamicResource Theme.CardBackgroundAlt}"
                                    BorderBrush="{DynamicResource Theme.CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0 0 0 10">
                                <StackPanel>
                                    <TextBlock Text="Snapshot Info" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                                    <TextBlock x:Name="DetailTitleTextBlock" Text="None Selected" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Theme.Foreground}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DetailDateTextBlock" Text="" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 2 0 0"/>
                                    <TextBlock x:Name="DetailReasonTextBlock" Text="" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 2 0 0"/>
                                    <TextBlock x:Name="DetailSizeTextBlock" Text="" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 2 0 0"/>
                                </StackPanel>
                            </Border>

                            <!-- Breakdown Card -->
                            <Border Background="{DynamicResource Theme.CardBackgroundAlt}"
                                    BorderBrush="{DynamicResource Theme.CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0 0 0 10">
                                <StackPanel>
                                    <TextBlock Text="Data Records" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 6"/>
                                    <TextBlock x:Name="DetailEntriesText" Text="• Time Entries: 0" FontSize="11.5" Foreground="{DynamicResource Theme.Foreground}"/>
                                    <TextBlock x:Name="DetailProjectsText" Text="• Projects: 0" FontSize="11.5" Foreground="{DynamicResource Theme.Foreground}" Margin="0 2 0 0"/>
                                    <TextBlock x:Name="DetailActivitiesText" Text="• Activities: 0" FontSize="11.5" Foreground="{DynamicResource Theme.Foreground}" Margin="0 2 0 0"/>
                                    <TextBlock x:Name="DetailPlansText" Text="• Calendar Plans: 0" FontSize="11.5" Foreground="{DynamicResource Theme.Foreground}" Margin="0 2 0 0"/>
                                </StackPanel>
                            </Border>

                            <!-- Files List Card -->
                            <Border Background="{DynamicResource Theme.CardBackgroundAlt}"
                                    BorderBrush="{DynamicResource Theme.CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0 0 0 10">
                                <StackPanel>
                                    <TextBlock Text="Included Files" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                                    <TextBlock x:Name="DetailFilesTextBlock" Text="None" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Margin="0 10 0 0">
                        <Button x:Name="DetailRestoreButton"
                                Content="🔄 Restore This Backup"
                                Style="{StaticResource SuccessButton}"
                                Height="34"
                                FontWeight="Bold"
                                Margin="0 0 0 6"
                                Click="RestoreSelectedButton_Click"/>

                        <Button x:Name="DetailExportButton"
                                Content="📤 Export to Zip"
                                Style="{StaticResource GhostButton}"
                                Height="28"
                                Click="ExportBackupButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Footer Bar -->
        <Grid Grid.Row="3">
            <TextBlock Text="💡 Tip: Auto-backups are retained for 2 months to save disk space, while manual backups are permanently preserved."
                       FontSize="11"
                       Foreground="{DynamicResource Theme.ForegroundMuted}"
                       VerticalAlignment="Center"/>

            <Button Content="Close"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right"
                    Padding="18 5"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
