<UserControl x:Class="VitorsWeeklyWorkTracking.Controls.PieChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             SizeChanged="UserControl_SizeChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Chart Title (Optional) -->
        <TextBlock x:Name="ChartTitleTextBlock" 
                   Grid.Row="0"
                   FontWeight="Bold" 
                   FontSize="13" 
                   Foreground="{DynamicResource Theme.Foreground}" 
                   HorizontalAlignment="Center" 
                   Margin="0 0 0 6"
                   Visibility="Collapsed"/>

        <!-- Canvas and Center Hub for the Pie / Donut -->
        <Grid Grid.Row="1" MinHeight="160" MinWidth="160" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Canvas x:Name="ChartCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True"/>
            
            <!-- Donut Center Hub (Visible in Donut mode when data is present) -->
            <Border x:Name="CenterHubBorder"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6">
                    <TextBlock x:Name="CenterHubLabel"
                               Text="TOTAL"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.ForegroundMuted}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="100"/>
                    <TextBlock x:Name="CenterHubValue"
                               Text="0h 00m"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.Foreground}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0 1 0 1"/>
                    <TextBlock x:Name="CenterHubPercent"
                               Text="100%"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Accent}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyMessagePanel"
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Border Width="54" Height="54" CornerRadius="27"
                        BorderBrush="{DynamicResource Theme.SecondaryBorder}"
                        BorderThickness="2"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        Margin="0 0 0 6">
                    <TextBlock Text="🥧" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No activity recorded" 
                           Foreground="{DynamicResource Theme.ForegroundMuted}" 
                           FontSize="12"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Legend (Scrollable if many items) -->
        <ScrollViewer Grid.Row="2" 
                      MaxHeight="120" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0 8 0 0">
            <WrapPanel x:Name="LegendPanel" 
                       Orientation="Horizontal" 
                       HorizontalAlignment="Center"/>
        </ScrollViewer>
    </Grid>
</UserControl>