<UserControl x:Class="VitorsWeeklyWorkTracking.Controls.AsciiCompanionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="800" d:DesignHeight="220">
    <Border Background="{DynamicResource Theme.CardBackground}"
            BorderBrush="{DynamicResource Theme.CardBorder}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,10">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header with Scene Selector, Mode toggle, Controls, and Collapse -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: ASCII Art Display & Story narration (Collapsible) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Work & Rest Interval Bar (Shown when interval mode active) -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header / Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <!-- Left: Scene Selector -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Middle: Status / Progress Badge -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Quick Action Buttons -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Scene Selector -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎨 Scene:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SceneComboBox"
                              Width="180"
                              Height="26"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="SceneComboBox_SelectionChanged"/>
                </StackPanel>

                <!-- Middle: Status Badge / Narration preview -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                    <Border x:Name="CompanionStatusBadge"
                            CornerRadius="12"
                            Padding="8,2"
                            Background="{DynamicResource Theme.CardBackgroundAlt}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CompanionStatusIcon" Text="🚴" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock x:Name="CompanionStatusText" Text="READY TO RIDE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}"/>
                        </StackPanel>
                    </Border>

                    <!-- Work/Rest Cycle Badge -->
                    <Border x:Name="IntervalCycleBadge"
                            CornerRadius="12"
                            Padding="8,2"
                            Background="{DynamicResource Theme.CardBackgroundAlt}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            Margin="6,0,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="IntervalCycleText" Text="🍅 Cycle 1/4" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.Primary}"/>
                    </Border>
                </StackPanel>

                <!-- Right: Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Fun Interact / Cheer Button -->
                    <Button x:Name="CheerButton"
                            Content="✨ Cheer!"
                            ToolTip="Cheer on companion or pet! (+Happiness)"
                            Style="{StaticResource GhostButton}"
                            Padding="8,2"
                            Height="24"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="0,0,4,0"
                            Click="CheerButton_Click"/>

                    <!-- Work & Rest Mode Toggle -->
                    <Button x:Name="IntervalModeToggleButton"
                            Content="🍅 Work/Rest"
                            ToolTip="Toggle Work &amp; Rest Interval Mode (Pomodoro / Study Cycles)"
                            Style="{StaticResource GhostButton}"
                            Padding="8,2"
                            Height="24"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="0,0,4,0"
                            Click="IntervalModeToggleButton_Click"/>

                    <!-- Settings Button -->
                    <Button x:Name="IntervalSettingsButton"
                            Content="⚙️"
                            ToolTip="Configure Work &amp; Rest Interval Durations"
                            Style="{StaticResource GhostButton}"
                            Padding="6,2"
                            Height="24"
                            FontSize="11"
                            Margin="0,0,4,0"
                            Click="IntervalSettingsButton_Click"/>

                    <!-- Expand / Collapse Button -->
                    <Button x:Name="ToggleExpandButton"
                            Content="▲"
                            ToolTip="Collapse / Expand Art Companion"
                            Style="{StaticResource GhostButton}"
                            Padding="6,2"
                            Height="24"
                            FontSize="10"
                            Click="ToggleExpandButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: ASCII Art Display & Story narration -->
            <Grid x:Name="ArtDisplayContainer" Grid.Row="1" Margin="0,2,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ASCII Canvas Box -->
                <Border Background="{DynamicResource Theme.CardBackgroundAlt}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Cursor="Hand"
                        ToolTip="Click to interact with art companion!"
                        MouseLeftButtonUp="ArtBox_MouseLeftButtonUp">
                    <TextBlock x:Name="AsciiArtTextBlock"
                               FontFamily="Consolas, Lucida Console, Courier New, monospace"
                               FontSize="12"
                               LineHeight="16"
                               Foreground="{DynamicResource Theme.Foreground}"
                               TextWrapping="NoWrap"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Story Narration Line -->
                <Grid Grid.Row="1" Margin="4,4,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StoryNarrativeTextBlock"
                               Text="🚴 Boy is pedaling steadily across the countryside towards home."
                               FontSize="11"
                               Foreground="{DynamicResource Theme.ForegroundMuted}"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock x:Name="PetLevelInfoTextBlock"
                               Grid.Column="1"
                               Text="⭐ Focus XP: 0"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Primary}"
                               Margin="8,0,0,0"
                               Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <!-- Row 2: Work & Rest Interval Status & Actions Bar -->
            <Border x:Name="IntervalActionBar"
                    Grid.Row="2"
                    Background="{DynamicResource Theme.CardBackgroundAlt}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="IntervalPhaseLabel"
                                   Text="🎯 FOCUS PHASE"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Foreground="{DynamicResource Theme.Primary}"
                                   Margin="0,0,8,0"/>
                        <TextBlock x:Name="IntervalPhaseTimerText"
                                   Text="24:50 remaining • Session 1 of 4"
                                   FontSize="11"
                                   Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ExtraRestButton"
                                Content="☕ +5m Rest"
                                ToolTip="Add 5 minutes to current break"
                                Style="{StaticResource GhostButton}"
                                Padding="8,1"
                                Height="22"
                                FontSize="10"
                                Margin="0,0,6,0"
                                Visibility="Collapsed"
                                Click="ExtraRestButton_Click"/>

                        <Button x:Name="SkipPhaseButton"
                                Content="⏩ Next Phase"
                                ToolTip="Skip or transition to the next Focus/Rest phase"
                                Style="{StaticResource GhostButton}"
                                Padding="8,1"
                                Height="22"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Click="SkipPhaseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
