<Window x:Class="VitorsWeeklyWorkTracking.WeeklyGoalAchievedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏆 Weekly Work Goal Achieved!"
        Icon="VitorWeeklyWorkTracking.ico"
        Width="700"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.Foreground}">
    <Border Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Extra Big Header Hero Banner -->
                <RowDefinition Height="Auto"/>
                <!-- 1: 4 Key Metrics Cards -->
                <RowDefinition Height="Auto"/>
                <!-- 2: 7-Day Weekly Strip -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Project Breakdown / Achievements -->
                <RowDefinition Height="*"/>
                <!-- 4: Footer Action Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0. Extra Big Header Hero Banner -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Theme.StatCard3Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard3Border}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="18,16"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="{DynamicResource Theme.StatCard3Border}"
                                    CornerRadius="10"
                                    Padding="10,3"
                                    Margin="0,0,8,0">
                                <TextBlock Text="🏆 WEEKLY MILESTONE PASSED"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Theme.PrimaryForeground}"/>
                            </Border>
                            <TextBlock x:Name="WeekRangeTextBlock"
                                       Text="Mon, 19 Oct - Sun, 25 Oct 2026"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.StatCard3Title}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="TotalTimeTextBlock"
                                   Text="🏆 0.0 hrs Weekly Target"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.StatCard3Text}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,2"/>

                        <TextBlock x:Name="GoalReachedTextBlock"
                                   Text="🏆 WEEKLY GOAL CRUSHED! 🎉"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.StatCard3Title}"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Incredible dedication! You have passed your total planned work time for the week. Celebrate your hard work and achievements!"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Theme.ForegroundMuted}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="🏆"
                                   FontSize="44"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. 4 Key Metrics Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Weekly Target -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Theme.CardBackground}"
                        BorderBrush="{DynamicResource Theme.CardBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="🎯 Weekly Target" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                        <TextBlock x:Name="TargetHoursTextBlock" Text="0.0 hrs" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Tracked -->
                <Border Grid.Column="1"
                        Background="{DynamicResource Theme.StatCard2Bg}"
                        BorderBrush="{DynamicResource Theme.StatCard2Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="⏱️ Total Tracked" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.StatCard2Title}"/>
                        <TextBlock x:Name="ActualHoursTextBlock" Text="0.0 hrs" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard2Text}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Completion % -->
                <Border Grid.Column="2"
                        Background="{DynamicResource Theme.StatCard1Bg}"
                        BorderBrush="{DynamicResource Theme.StatCard1Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="📈 Completion" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.StatCard1Title}"/>
                        <TextBlock x:Name="CompletionRateTextBlock" Text="100%" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Text}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Surplus / Variance -->
                <Border Grid.Column="3"
                        Background="{DynamicResource Theme.StatCard4Bg}"
                        BorderBrush="{DynamicResource Theme.StatCard4Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="🚀 Surplus" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.StatCard4Title}"/>
                        <TextBlock x:Name="SurplusTextBlock" Text="+0.0 hrs" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard4Text}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. 7-Day Weekly Strip -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="📅 7-Day Week Progress"
                               FontWeight="Bold"
                               FontSize="11.5"
                               Foreground="{DynamicResource Theme.Foreground}"
                               Margin="0,0,0,6"/>

                    <ItemsControl Grid.Row="1" x:Name="DailyStripItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Theme.CardBackgroundAlt}"
                                        BorderBrush="{DynamicResource Theme.CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4,6"
                                        Margin="2,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ShortDayName}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.Foreground}"/>
                                        <TextBlock Text="{Binding ShortDateFormatted}" FontSize="9.5" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        <TextBlock Text="{Binding DayStatusEmoji}" FontSize="13" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding FormattedActualHours}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Primary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding FormattedPlannedHours, StringFormat='Plan: {0}'}" FontSize="9" Foreground="{DynamicResource Theme.ForegroundSubtle}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- 3. Project Breakdown / Comparisons Section -->
            <Border Grid.Row="3"
                    Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="📊 Project Contributions This Week"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="{DynamicResource Theme.Foreground}"
                               Margin="0,0,0,8"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ProjectComparisonsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Theme.CardBackgroundAlt}"
                                            BorderBrush="{DynamicResource Theme.CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProjectName}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Theme.Foreground}"/>
                                                <TextBlock Text="{Binding FormattedActual, StringFormat='Tracked: {0}'}" FontSize="10.5" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FormattedPlanned, StringFormat='Plan: {0}'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Theme.ForegroundSubtle}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0"/>

                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource Theme.CardBackground}"
                                                    BorderBrush="{DynamicResource Theme.CardBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedPercentage}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme.Success}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 4. Footer Action Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="📅 View Planner"
                        Height="34"
                        Padding="14,0"
                        Margin="0,0,8,0"
                        Click="OpenPlannerButton_Click"/>

                <Button Grid.Column="1"
                        Content="📊 View Analytics"
                        Height="34"
                        Padding="14,0"
                        Click="OpenAnalyticsButton_Click"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0">
                    <TextBlock x:Name="AutoDismissTextBlock"
                               Text="⏱️ Fading out in 25s"
                               FontSize="11"
                               Foreground="{DynamicResource Theme.ForegroundMuted}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Tracking continues in background"
                               FontSize="10"
                               Foreground="{DynamicResource Theme.ForegroundSubtle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="CelebrateButton"
                        Grid.Column="3"
                        Content="🎉 Celebrate &amp; Keep Going"
                        Style="{DynamicResource PrimaryButton}"
                        Height="34"
                        Padding="20,0"
                        Click="CelebrateButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
