<Window x:Class="VitorsWeeklyWorkTracking.ProjectManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Projects"
        Icon="VitorWeeklyWorkTracking.ico"
        Height="450"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme.WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Add Project Section Card -->
        <Border Grid.Row="0"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0 0 0 12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Add New Project" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme.Foreground}" Margin="0 0 0 8"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewProjectTextBox"
                             Grid.Column="0"
                             Margin="0 0 10 0"
                             Padding="8 6"
                             KeyDown="NewProjectTextBox_KeyDown"/>
                    <Button Grid.Column="1"
                            Content="➕ Add"
                            Style="{StaticResource PrimaryButton}"
                            Width="80"
                            Height="30"
                            Click="AddProjectButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Projects Lists -->
        <TabControl Grid.Row="1">
            <TabItem Header="🟢 Active Projects">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0 0 0 8">
                        <ListBox x:Name="ActiveProjectsListBox" DisplayMemberPath="Name"/>
                        <Border x:Name="ActiveProjectsEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📁" FontSize="22" HorizontalAlignment="Center" Margin="0 0 0 4" Opacity="0.6"/>
                                <TextBlock Text="There are no active projects currently" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Add a new project above to get started" FontSize="10.5" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center" Margin="0 2 0 0" Opacity="0.8"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="📦 Archive (Mark Inactive)"
                                Style="{StaticResource GhostDangerButton}"
                                Padding="10 5"
                                Click="ArchiveProjectButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="📁 Inactive / Archived">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0 0 0 8">
                        <ListBox x:Name="InactiveProjectsListBox" DisplayMemberPath="Name"/>
                        <Border x:Name="InactiveProjectsEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" Margin="0 0 0 4" Opacity="0.6"/>
                                <TextBlock Text="There are no archived projects currently" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🟢 Activate (Mark Active)"
                                Style="{StaticResource SuccessButton}"
                                Padding="10 5"
                                Click="ActivateProjectButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Close Section -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
            <Button Content="Close" Width="85" Height="30" Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
