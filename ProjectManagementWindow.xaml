<Window x:Class="VitorsWeeklyWorkTracking.ProjectManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Projects &amp; Colors"
        Icon="VitorWeeklyWorkTracking.ico"
        Height="640"
        Width="580"
        MinHeight="540"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Theme.WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Add Project Section -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Search Section -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Projects List -->
            <RowDefinition Height="*"/>
            <!-- 3: Color Picker Section -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Close Section -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Add Project Section Card -->
        <Border Grid.Row="0"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14 12"
                Margin="0 0 0 10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="📁 Add New Project" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Theme.Foreground}" Margin="0 0 0 8"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewProjectTextBox"
                             Grid.Column="0"
                             Margin="0 0 10 0"
                             Padding="8 6"
                             KeyDown="NewProjectTextBox_KeyDown"/>
                    <Button Grid.Column="1"
                            Content="➕ Add Project"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12 5"
                            Height="32"
                            Click="AddProjectButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Search & Filter Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12 8"
                Margin="0 0 0 10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="0 0 8 0"/>
                <TextBox x:Name="ProjectSearchTextBox"
                         Grid.Column="1"
                         Height="28"
                         Padding="6 2"
                         FontSize="11.5"
                         VerticalContentAlignment="Center"
                         ToolTip="Search projects by name..."
                         TextChanged="ProjectSearchTextBox_TextChanged"/>
                <Button x:Name="ClearSearchButton"
                        Grid.Column="2"
                        Content="✕"
                        Style="{StaticResource GhostButton}"
                        Height="28"
                        Width="28"
                        Padding="0"
                        Margin="6 0 0 0"
                        ToolTip="Clear search filter"
                        Visibility="Collapsed"
                        Click="ClearSearchButton_Click"/>
            </Grid>
        </Border>

        <!-- Projects Lists -->
        <TabControl x:Name="ProjectsTabControl" Grid.Row="2" SelectionChanged="ProjectsTabControl_SelectionChanged" Margin="0 0 0 10">
            <TabItem Header="🟢 Active Projects">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0 0 0 8">
                        <ListBox x:Name="ActiveProjectsListBox" SelectionChanged="ProjectListBox_SelectionChanged" MouseDoubleClick="ProjectListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2 4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="14"
                                                Height="14"
                                                CornerRadius="7"
                                                Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                                BorderThickness="1"
                                                Margin="0 0 10 0"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Theme.Foreground}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="ActiveProjectsEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📁" FontSize="22" HorizontalAlignment="Center" Margin="0 0 0 4" Opacity="0.6"/>
                                <TextBlock x:Name="ActiveProjectsEmptyStateTitle" Text="There are no active projects currently" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ActiveProjectsEmptyStateSubtitle" Text="Add a new project above to get started" FontSize="10.5" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center" Margin="0 2 0 0" Opacity="0.8"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="🔄 Sync from Data"
                                Style="{StaticResource GhostButton}"
                                Padding="8 4"
                                ToolTip="Import any project names from your recorded time entries and calendar plans"
                                Click="SyncProjectsButton_Click"/>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Content="🚩 Milestones"
                                    Style="{StaticResource GhostButton}"
                                    Padding="8 4"
                                    Margin="0 0 6 0"
                                    ToolTip="Add and manage milestones for the selected project"
                                    Click="ProjectMilestonesButton_Click"/>
                            <Button Content="✏️ Rename"
                                    Style="{StaticResource GhostButton}"
                                    Padding="8 4"
                                    Margin="0 0 6 0"
                                    ToolTip="Rename the selected project"
                                    Click="RenameProjectButton_Click"/>
                            <Button Content="📦 Archive"
                                    Style="{StaticResource GhostDangerButton}"
                                    Padding="8 4"
                                    Margin="0 0 6 0"
                                    ToolTip="Mark project as inactive"
                                    Click="ArchiveProjectButton_Click"/>
                            <Button Content="🗑️ Delete"
                                    Style="{StaticResource DangerButton}"
                                    Padding="8 4"
                                    ToolTip="Delete project from project list"
                                    Click="DeleteProjectButton_Click"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="📁 Inactive / Archived">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0 0 0 8">
                        <ListBox x:Name="InactiveProjectsListBox" SelectionChanged="ProjectListBox_SelectionChanged" MouseDoubleClick="ProjectListBox_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2 4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="14"
                                                Height="14"
                                                CornerRadius="7"
                                                Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                                BorderThickness="1"
                                                Margin="0 0 10 0"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Theme.Foreground}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="InactiveProjectsEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📦" FontSize="22" HorizontalAlignment="Center" Margin="0 0 0 4" Opacity="0.6"/>
                                <TextBlock x:Name="InactiveProjectsEmptyStateTitle" Text="There are no archived projects currently" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="InactiveProjectsEmptyStateSubtitle" Text="Check your search filter" FontSize="10.5" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center" Margin="0 2 0 0" Opacity="0.8" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="🔄 Sync from Data"
                                Style="{StaticResource GhostButton}"
                                Padding="8 4"
                                ToolTip="Import any project names from your recorded time entries and calendar plans"
                                Click="SyncProjectsButton_Click"/>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Content="✏️ Rename"
                                    Style="{StaticResource GhostButton}"
                                    Padding="8 4"
                                    Margin="0 0 6 0"
                                    ToolTip="Rename the selected project"
                                    Click="RenameProjectButton_Click"/>
                            <Button Content="🟢 Activate"
                                    Style="{StaticResource SuccessButton}"
                                    Padding="8 4"
                                    Margin="0 0 6 0"
                                    ToolTip="Reactivate project"
                                    Click="ActivateProjectButton_Click"/>
                            <Button Content="🗑️ Delete"
                                    Style="{StaticResource DangerButton}"
                                    Padding="8 4"
                                    ToolTip="Delete project from project list"
                                    Click="DeleteProjectButton_Click"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Color Customization Card -->
        <Border Grid.Row="3"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12 10">
            <StackPanel>
                <Grid Margin="0 0 0 8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎨" FontSize="13" VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <TextBlock x:Name="ColorTargetLabel"
                                   Text="Select a project above to customize its color (Default: Grey)"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{DynamicResource Theme.Foreground}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="CurrentColorIndicator"
                                Width="16"
                                Height="16"
                                CornerRadius="8"
                                Background="#6B7280"
                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                BorderThickness="1"
                                Margin="0 0 6 0"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="CurrentColorHexLabel"
                                   Text="#6B7280"
                                   FontFamily="Consolas, monospace"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.ForegroundMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Color Swatch Palette Grid -->
                <WrapPanel x:Name="PaletteSwatchesPanel" Margin="0 0 0 8"/>

                <!-- Custom Hex, Color Wheel & Reset Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="HEX:"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Foreground="{DynamicResource Theme.ForegroundMuted}"
                               VerticalAlignment="Center"
                               Margin="0 0 6 0"/>
                    <TextBox x:Name="CustomHexTextBox"
                             Grid.Column="1"
                             Height="26"
                             Padding="4 2"
                             FontFamily="Consolas, monospace"
                             FontSize="11"
                             VerticalContentAlignment="Center"
                             Margin="0 0 6 0"
                             KeyDown="CustomHexTextBox_KeyDown"/>
                    <Button x:Name="ApplyCustomHexButton"
                            Grid.Column="2"
                            Content="Apply"
                            Style="{StaticResource GhostButton}"
                            Height="26"
                            Padding="8 0"
                            FontSize="11"
                            Margin="0 0 6 0"
                            Click="ApplyCustomHexButton_Click"/>
                    <Button x:Name="OpenColorWheelButton"
                            Grid.Column="3"
                            Content="🌈 Color Wheel..."
                            Style="{StaticResource GhostButton}"
                            Height="26"
                            Padding="8 0"
                            FontSize="11"
                            ToolTip="Open interactive color wheel and spectrum picker"
                            Click="OpenColorWheelButton_Click"/>
                    <Button x:Name="ResetColorButton"
                            Grid.Column="5"
                            Content="↺ Reset to Grey"
                            Style="{StaticResource GhostButton}"
                            Height="26"
                            Padding="8 0"
                            FontSize="11"
                            ToolTip="Reset project color back to default grey"
                            Click="ResetColorButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Close Section -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button Content="Close" Width="85" Height="30" Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
