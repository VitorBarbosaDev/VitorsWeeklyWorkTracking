<Window x:Class="VitorsWeeklyWorkTracking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VitorsWeeklyWorkTracking.Controls"
        Title="Fun Work Tracker"
        Icon="VitorWeeklyWorkTracking.ico"
        Height="760"
        Width="940"
        MinHeight="600"
        MinWidth="780"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Background="{DynamicResource Theme.WindowBackground}">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="AppTaskbarItemInfo"/>
    </Window.TaskbarItemInfo>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid Margin="14 12" MinHeight="580">
        <Grid.RowDefinitions>
            <!-- 0: Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Active Tracker & Alert Card -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Animated Art & Focus Companion Card -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Filter Bar Card -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Session Log DataGrid Card -->
            <RowDefinition Height="*"/>
            <!-- 5: Weekly & Daily Goal Progress Card -->
            <RowDefinition Height="Auto"/>
            <!-- 6: Summary Stats Card -->
            <RowDefinition Height="Auto"/>
            <!-- 7: Bottom Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Bar: Logo, Title, Live Status Badge, Mini Overlay & Theme Selector -->
        <Grid Grid.Row="0" Margin="0 0 0 14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏱️" FontSize="18" Margin="0 0 6 0" VerticalAlignment="Center"/>
                    <TextBlock Text="Fun Work Tracker" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Track hours, manage projects &amp; analyze your work" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="26 2 0 0"/>
            </StackPanel>

            <!-- Center Live Status Badge -->
            <Border Grid.Column="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="10 4"
                    Margin="6 0">
                <TextBlock x:Name="StatusTextBlock"
                           Text="Status: Idle"
                           FontWeight="SemiBold"
                           FontSize="11.5"
                           Foreground="{DynamicResource Theme.ForegroundMuted}"/>
            </Border>

            <!-- Right Controls: Mini Timer Corner Selector & Theme Switcher -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!--~1~ Pomodoro Mode Quick Toggle Button @1@
                <Button x:Name="PomodoroQuickToggleButton"
                        Content="🍅 Pomodoro: OFF"
                        ToolTip="Toggle Pomodoro Interval Mode (Focus sprints &amp; rest breaks vs continuous tracking)"
                        Style="{StaticResource GhostButton}"
                        Height="28"
                        Padding="6 0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Margin="0 0 6 0"
                        Click="PomodoroQuickToggleButton_Click"/>-->

                <!-- Sound & Settings Quick Button -->
                <Button x:Name="AudioSettingsQuickButton"
                        Content="⚙️ Settings"
                        ToolTip="Configure interval settings, display monitor, and sound effects"
                        Style="{StaticResource GhostButton}"
                        Height="28"
                        Padding="6 0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Margin="0 0 6 0"
                        Click="AudioSettingsQuickButton_Click"/>

                <!-- Companion Toggle Button -->
                <Button x:Name="CompanionQuickToggleButton"
                        Content="🎨 Companion"
                        ToolTip="Toggle Animated Art &amp; Game Companion"
                        Height="28"
                        Padding="6 0"
                        FontSize="11"
                        Margin="0 0 6 0"
                        Click="CompanionQuickToggleButton_Click"/>

                <!-- Mini Floating Timer Options -->
                <TextBlock Text="🗗 Mini:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 4 0" VerticalAlignment="Center"/>
                <!--<ComboBox x:Name="MiniMonitorComboBox"
                          Width="98"
                          Margin="0 0 4 0"
                          ToolTip="Select target display monitor for the floating mini timer"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="MiniMonitorComboBox_SelectionChanged"/>
                <ComboBox x:Name="MiniCornerComboBox"
                          Width="88"
                          Margin="0 0 4 0"
                          ToolTip="Select screen corner or disable mini timer"
                          SelectionChanged="MiniCornerComboBox_SelectionChanged"/>-->
                
                <Button x:Name="MiniOverlayQuickButton"
                        Content="↘ Mini"
                        ToolTip="Switch to Floating Corner Widget"
                        Height="28"
                        Padding="6 0"
                        FontSize="11"
                        Margin="0 0 8 0"
                        Click="MiniOverlayQuickButton_Click"/>

                <!-- Theme Switcher -->
                <TextBlock Text="🎨 Theme:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 4 0" VerticalAlignment="Center"/>
                <ComboBox x:Name="ThemeComboBox"
                          Width="135"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="ThemeComboBox_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <!-- 2. Active Tracker Hero Card & Alert Banner -->
        <StackPanel Grid.Row="1" Margin="0 0 0 12">
            <!-- Rest & Focus Interval Alert Banner -->
            <Border x:Name="IntervalAlertBanner"
                    Background="{DynamicResource Theme.CardBackgroundAlt}"
                    BorderBrush="{DynamicResource Theme.Primary}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="14 10"
                    Margin="0 0 0 10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="IntervalAlertIcon" Text="🔔" FontSize="26" VerticalAlignment="Center" Margin="0 0 12 0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="IntervalAlertTitle" Text="🔔 Rest Time! Great Job!" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}"/>
                        <TextBlock x:Name="IntervalAlertMessage" Text="You've finished your 25-minute focus session. Time for a 5-minute break!" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 2 0 2" TextWrapping="Wrap"/>
                        <TextBlock x:Name="IntervalAlertTip" Text="💧 Grab a refreshing glass of water and hydrate!" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Success}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12 0 0 0">
                        <Button x:Name="IntervalAlertPrimaryAction"
                                Content="☕ Start Rest"
                                Style="{StaticResource SuccessButton}"
                                Height="28"
                                Padding="12 0"
                                FontSize="11"
                                FontWeight="Bold"
                                Margin="0 0 6 0"
                                Click="IntervalAlertPrimaryAction_Click"/>
                        <Button x:Name="IntervalAlertSecondaryAction"
                                Content="⚡ Skip Break &amp; Work"
                                ToolTip="Skip the break and start next focus sprint immediately"
                                Style="{StaticResource PrimaryButton}"
                                Height="28"
                                Padding="10 0"
                                FontSize="11"
                                FontWeight="Bold"
                                Margin="0 0 6 0"
                                Visibility="Collapsed"
                                Click="IntervalAlertSecondaryAction_Click"/>
                        <Button x:Name="IntervalAlertDismissButton"
                                Content="✕ Dismiss"
                                Style="{StaticResource GhostButton}"
                                Height="28"
                                Padding="10 0"
                                FontSize="11"
                                Click="IntervalAlertDismissButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hero Card -->
            <Border Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left Hero Section: Big Circular Button & Prominent Digital Timer & Status -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center Divider -->
                    <ColumnDefinition Width="1"/>
                    <!-- Right Input Fields Section -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Hero Section -->
                <Grid Grid.Column="0" Margin="0 0 14 0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Big Circular Start / Stop Button Slot -->
                        <Grid Width="92" Height="92" Margin="4 2 8 2" VerticalAlignment="Center">
                            <!-- Start Button -->
                            <Button x:Name="StartButton"
                                    Style="{StaticResource CircularStartButton}"
                                    Width="92"
                                    Height="92"
                                    Click="StartButton_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="▶" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="2 0 0 1"/>
                                    <TextBlock Text="START" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Stop Button -->
                            <Button x:Name="StopButton"
                                    Style="{StaticResource CircularStopButton}"
                                    Width="92"
                                    Height="92"
                                    Click="StopButton_Click"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⏹" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 1"/>
                                    <TextBlock Text="STOP" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Resume Button (Shown when session is stopped and ready to resume/save) -->
                            <Button x:Name="ResumeButton"
                                    Style="{StaticResource CircularResumeButton}"
                                    Width="92"
                                    Height="92"
                                    ToolTip="Resume tracking this session"
                                    Click="ResumeButton_Click"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="▶" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="2 0 0 1"/>
                                    <TextBlock Text="RESUME" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Prominent Timer & Status Details -->
                        <StackPanel VerticalAlignment="Center" Margin="12 0 6 0" MinWidth="175" MaxWidth="215">
                            <!-- Prominent Status Badge / Pill -->
                            <Border x:Name="HeroStatusBadge"
                                    HorizontalAlignment="Left"
                                    CornerRadius="10"
                                    Padding="8 3"
                                    Background="{DynamicResource Theme.CardBackgroundAlt}"
                                    BorderBrush="{DynamicResource Theme.CardBorder}"
                                    BorderThickness="1"
                                    Margin="0 0 0 4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="HeroStatusDot" Width="7" Height="7" Fill="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 5 0"/>
                                    <TextBlock x:Name="HeroStatusBadgeText"
                                               Text="READY"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                </StackPanel>
                            </Border>

                            <!-- Prominent Big Digital Clock & Mode Toggle Row -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 2">
                                <TextBlock x:Name="TimerDisplayTextBlock"
                                           Text="00:00:00"
                                           FontFamily="Consolas, Segoe UI, sans-serif"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Theme.Foreground}"
                                           Cursor="Hand"
                                           ToolTip="Click to toggle Count Up / Count Down mode"
                                           MouseLeftButtonUp="TimerDisplayTextBlock_MouseLeftButtonUp"/>

                                <Button x:Name="TimerModeToggleButton"
                                        Content="⏱ UP"
                                        ToolTip="Toggle Count Up / Count Down mode"
                                        Style="{StaticResource GhostButton}"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Padding="5 2"
                                        Height="22"
                                        Margin="4 0 0 0"
                                        VerticalAlignment="Center"
                                        Click="TimerModeToggleButton_Click"/>
                            </StackPanel>

                            <!-- Goal Progress Bar (Shown when a Goal is set) -->
                            <StackPanel x:Name="GoalProgressContainer" Margin="0 0 0 4" Visibility="Collapsed">
                                <ProgressBar x:Name="GoalProgressBar" Height="6" Margin="0 0 0 2"/>
                                <TextBlock x:Name="GoalStatsTextBlock"
                                           Text="0% • 00:00 / 25:00 (25m left)"
                                           FontSize="10"
                                           Foreground="{DynamicResource Theme.ForegroundMuted}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Prominent Status Headline -->
                            <TextBlock x:Name="HeroStatusHeadline"
                                       Text="Ready to Track"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Foreground}"
                                       MaxWidth="210"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Prominent Status Subhead -->
                            <TextBlock x:Name="HeroStatusSubhead"
                                       Text="Select project &amp; activity to begin"
                                       FontSize="10"
                                       Foreground="{DynamicResource Theme.ForegroundMuted}"
                                       MaxWidth="210"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Interval Quick Action Bar (When Interval Mode Active) -->
                            <StackPanel x:Name="IntervalHeroActionBar"
                                        Orientation="Horizontal"
                                        Margin="0 4 0 0"
                                        Visibility="Collapsed">
                                <Button x:Name="HeroStopBreakButton"
                                        Content="⚡ Stop Break &amp; Work"
                                        ToolTip="Stop break early and start the next focus sprint immediately"
                                        Style="{StaticResource SuccessButton}"
                                        Height="22"
                                        Padding="8 0"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Margin="0 0 4 0"
                                        Visibility="Collapsed"
                                        Click="HeroStopBreakButton_Click"/>
                                <Button x:Name="HeroNextSessionButton"
                                        Content="⏩ Next Session"
                                        ToolTip="Complete current sprint and start next focus session (skip break)"
                                        Style="{StaticResource GhostButton}"
                                        Height="22"
                                        Padding="6 0"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Margin="0 0 4 0"
                                        Visibility="Collapsed"
                                        Click="HeroNextSessionButton_Click"/>
                                <Button x:Name="HeroTakeBreakButton"
                                        Content="☕ Take Break"
                                        ToolTip="End focus sprint early and start rest break"
                                        Style="{StaticResource GhostButton}"
                                        Height="22"
                                        Padding="6 0"
                                        FontSize="10"
                                        Margin="0 0 4 0"
                                        Visibility="Collapsed"
                                        Click="HeroTakeBreakButton_Click"/>
                                <Button x:Name="HeroExtraRestButton"
                                        Content="☕ +5m"
                                        ToolTip="Add 5 minutes to current rest break"
                                        Style="{StaticResource GhostButton}"
                                        Height="22"
                                        Padding="6 0"
                                        FontSize="10"
                                        Visibility="Collapsed"
                                        Click="HeroExtraRestButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Vertical Divider -->
                <Rectangle Grid.Column="1" Fill="{DynamicResource Theme.CardBorder}" Margin="0 2"/>

                <!-- Right Input Fields Section -->
                <Grid Grid.Column="2" Margin="14 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Project, Activity, and Goal Selectors -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="145"/>
                        </Grid.ColumnDefinitions>

                        <!-- Project Field -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="📁 Project" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ProjectComboBox"
                                          DisplayMemberPath="Name"
                                          HorizontalAlignment="Stretch"/>
                                <Button x:Name="AddProjectQuickButton"
                                        Grid.Column="1"
                                        Content="+"
                                        ToolTip="Add / Manage Projects"
                                        FontWeight="Bold"
                                        FontSize="13"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Margin="4 0 0 0"
                                        Click="AddNewProjectButton_Click"/>
                            </Grid>
                        </Grid>

                        <!-- Activity Field -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="🏷️ Activity" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ActivityComboBox"
                                          DisplayMemberPath="Name"
                                          IsEditable="True"
                                          HorizontalAlignment="Stretch"/>
                                <Button x:Name="AddActivityQuickButton"
                                        Grid.Column="1"
                                        Content="+"
                                        ToolTip="Add / Manage Activities"
                                        FontWeight="Bold"
                                        FontSize="13"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Margin="4 0 0 0"
                                        Click="AddNewActivityButton_Click"/>
                            </Grid>
                        </Grid>

                        <!-- Goal Selector Field -->
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="🎯 Goal / Timer Mode" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                            <ComboBox x:Name="GoalComboBox"
                                      Grid.Row="1"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="GoalComboBox_SelectionChanged"/>
                        </Grid>
                    </Grid>

                    <!-- Row 1: Task Description & Notes -->
                    <Grid Grid.Row="1" Margin="0 8 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Task Description -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="📝 Task Description" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                            <TextBox x:Name="DescriptionTextBox"
                                     Grid.Row="1"
                                     Height="40"
                                     VerticalContentAlignment="Center"/>
                        </Grid>

                        <!-- Notes Area with Styled ScrollBar and Up/Down Buttons -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="💬 Notes" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                            <TextBox x:Name="NoteTextBox"
                                     Grid.Row="1"
                                     Height="40"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>

                    <!-- Row 2: Review & Save Action Banner (Displayed after stopping timer) -->
                    <Border x:Name="ReviewActionBar"
                            Grid.Row="2"
                            Visibility="Collapsed"
                            Background="{DynamicResource Theme.CardBackgroundAlt}"
                            BorderBrush="{DynamicResource Theme.Primary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10 6"
                            Margin="0 8 0 0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="⏱️ Session Recorded — Ready to Save or Resume" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme.Foreground}"/>
                                <TextBlock Text="Review details to save, resume session, or discard." FontSize="10" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ResumeSessionButton"
                                        Content="▶ Resume"
                                        ToolTip="Resume this session and continue tracking time"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="28"
                                        Padding="12 0"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        Margin="0 0 6 0"
                                        Click="ResumeButton_Click"/>

                                <Button x:Name="SaveEntryButton"
                                        Content="✔ Save Entry"
                                        Style="{StaticResource SuccessButton}"
                                        Height="28"
                                        Padding="14 0"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        Margin="0 0 6 0"
                                        Click="SaveEntryButton_Click"/>

                                <Button x:Name="DiscardButton"
                                        Content="✖ Discard"
                                        Style="{StaticResource GhostDangerButton}"
                                        Height="28"
                                        Padding="10 0"
                                        FontSize="11"
                                        Click="DiscardButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            </Border>
        </StackPanel>

        <!-- 3. Animated Art & Focus Companion Card -->
        <controls:AsciiCompanionControl x:Name="CompanionControl"
                                         Grid.Row="2"
                                         Margin="0 0 0 12"/>

        <!-- 4. Filter Bar Card -->
        <Border Grid.Row="3"
                Background="{DynamicResource Theme.CardBackgroundAlt}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12 8"
                Margin="0 0 0 10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="🔍 Filter:" FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 8 0" Foreground="{DynamicResource Theme.Foreground}"/>

                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0 0 4 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                <DatePicker x:Name="FilterStartDatePicker"
                            Width="110"
                            Margin="0 0 6 0"
                            SelectedDateChanged="Filter_Changed"/>

                <TextBlock Text="To:" VerticalAlignment="Center" Margin="0 0 4 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                <DatePicker x:Name="FilterEndDatePicker"
                            Width="110"
                            Margin="0 0 8 0"
                            SelectedDateChanged="Filter_Changed"/>

                <TextBlock Text="Project:" VerticalAlignment="Center" Margin="0 0 4 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                <ComboBox x:Name="FilterProjectComboBox"
                          Width="125"
                          Margin="0 0 8 0"
                          SelectionChanged="Filter_Changed"/>

                <TextBlock Text="Activity:" VerticalAlignment="Center" Margin="0 0 4 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                <ComboBox x:Name="FilterActivityComboBox"
                          Width="125"
                          Margin="0 0 8 0"
                          SelectionChanged="Filter_Changed"/>

                <Button Content="Today"
                        Width="65"
                        Height="28"
                        Margin="0 0 4 0"
                        Click="TodayButton_Click"/>

                <Button Content="Show All"
                        Width="75"
                        Height="28"
                        Click="ShowAllButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- 5. Session Log DataGrid Card -->
        <Border Grid.Row="4"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0"
                ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="EntriesDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          BorderThickness="0"
                          PreviewKeyDown="EntriesDataGrid_PreviewKeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="135"/>
                        <DataGridTextColumn Header="Activity" Binding="{Binding Activity}" Width="120"/>
                        <DataGridTextColumn Header="Description / Task" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat=\{0:HH:mm:ss\}}" Width="78"/>
                        <DataGridTextColumn Header="End" Binding="{Binding EndTime, StringFormat=\{0:HH:mm:ss\}}" Width="78"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration, StringFormat=\{0:hh\\:mm\\:ss\}}" Width="78"/>
                        <DataGridTemplateColumn Header="Action" Width="68">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Delete"
                                            Style="{StaticResource GhostDangerButton}"
                                            FontSize="11"
                                            Padding="4 2"
                                            Margin="2"
                                            Click="DeleteEntryButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Message Overlay (Headers remain visible above) -->
                <Border x:Name="EntriesEmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0 35 0 0"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                        <TextBlock Text="📋" FontSize="26" HorizontalAlignment="Center" Margin="0 0 0 6" Opacity="0.6"/>
                        <TextBlock Text="There are no entries currently" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Start a new tracking session above or adjust your date and project filters" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center" Margin="0 4 0 0" Opacity="0.8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 6. Weekly & Daily Goal Progress Card -->
        <Border Grid.Row="5"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14 10"
                Margin="0 10 0 0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Row: Weekly Goal summary headline, Today's Goal badge & Open Calendar Planner button -->
                <Grid Grid.Row="0" Margin="0 0 0 6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎯" FontSize="14" Margin="0 0 6 0" VerticalAlignment="Center"/>
                        <TextBlock Text="WEEKLY GOAL (MON-SUN):" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme.Primary}" VerticalAlignment="Center" Margin="0 0 8 0"/>
                        <TextBlock x:Name="GoalSummaryHeadlineText" Text="0.0h planned • 0.0h worked (0%)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Theme.Foreground}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Today's Goal Quick Badge -->
                    <Border Grid.Column="1"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource Theme.CardBackgroundAlt}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10 3"
                            Margin="10 0">
                        <TextBlock x:Name="GoalTodayBadgeText" Text="📅 Today: 0.0h plan • 0.0h act" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}"/>
                    </Border>

                    <!-- Open Planner Button -->
                    <Button Grid.Column="2"
                            Content="📅 Work Planner / Goals"
                            Style="{StaticResource GhostButton}"
                            Height="26"
                            Padding="10 0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Click="OpenCalendarPlanner_Click"/>
                </Grid>

                <!-- Middle Row: Goal Progress Bar with % indicator -->
                <Grid Grid.Row="1" Margin="0 2 0 6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="GoalWeeklyProgressBar" Grid.Column="0" Height="8" Maximum="100" Value="0" VerticalAlignment="Center" Margin="0 0 10 0" Foreground="{DynamicResource Theme.Primary}"/>
                    <TextBlock x:Name="GoalWeeklyProgressPctText" Grid.Column="1" Text="0.0%" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Theme.Primary}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Bottom Row: 7-Day Mini Week Trackers (Mon to Sun) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mini Day 0 (Mon) ... Mini Day 6 (Sun) -->
                    <Border x:Name="MiniDay0Border" Grid.Column="0" Background="{DynamicResource Theme.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="4 2" Margin="0 0 2 0">
                        <TextBlock x:Name="MiniDay0Text" Text="Mon: 0h/0h" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.ForegroundMuted}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Border x:Name="MiniDay1Border" Grid.Column="1" Background="{DynamicResource Theme.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="4 2" Margin="2 0 2 0">
                        <TextBlock x:Name="MiniDay1Text" Text="Tue: 0h/0h" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.ForegroundMuted}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Border x:Name="MiniDay2Border" Grid.Column="2" Background="{DynamicResource Theme.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="4 2" Margin="2 0 2 0">
                        <TextBlock x:Name="MiniDay2Text" Text="Wed: 0h/0h" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.ForegroundMuted}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Border x:Name="MiniDay3Border" Grid.Column="3" Background="{DynamicResource Theme.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="4 2" Margin="2 0 2 0">
                        <TextBlock x:Name="MiniDay3Text" Text="Thu: 0h/0h" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.ForegroundMuted}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Border x:Name="MiniDay4Border" Grid.Column="4" Background="{DynamicResource Theme.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="4 2" Margin="2 0 2 0">
                        <TextBlock x:Name="MiniDay4Text" Text="Fri: 0h/0h" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.ForegroundMuted}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Border x:Name="MiniDay5Border" Grid.Column="5" Background="{DynamicResource Theme.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="4 2" Margin="2 0 2 0">
                        <TextBlock x:Name="MiniDay5Text" Text="Sat: 0h/0h" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.ForegroundSubtle}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Border x:Name="MiniDay6Border" Grid.Column="6" Background="{DynamicResource Theme.CardBackgroundAlt}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="4 2" Margin="2 0 0 0">
                        <TextBlock x:Name="MiniDay6Text" Text="Sun: 0h/0h" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.ForegroundSubtle}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 7. Summary Statistics Bar (4 KPI Cards) -->
        <Grid Grid.Row="6" Margin="0 10 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Time -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Theme.StatCard1Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard1Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="0 0 4 0">
                <StackPanel>
                    <TextBlock Text="TOTAL TIME WORKED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Title}"/>
                    <TextBlock x:Name="StatsTotalTimeTextBlock" Text="0h 00m 00s" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Text}" Margin="0 3 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Total Sessions -->
            <Border Grid.Column="1"
                    Background="{DynamicResource Theme.StatCard2Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard2Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="2 0 2 0">
                <StackPanel>
                    <TextBlock Text="TOTAL SESSIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard2Title}"/>
                    <TextBlock x:Name="StatsTotalSessionsTextBlock" Text="0 sessions" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard2Text}" Margin="0 3 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Top Project -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Theme.StatCard3Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard3Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="2 0 2 0">
                <StackPanel>
                    <TextBlock Text="TOP PROJECT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard3Title}"/>
                    <TextBlock x:Name="StatsTopProjectTextBlock" Text="None" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard3Text}" Margin="0 3 0 0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Top Activity -->
            <Border Grid.Column="3"
                    Background="{DynamicResource Theme.StatCard4Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard4Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="4 0 0 0">
                <StackPanel>
                    <TextBlock Text="TOP ACTIVITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard4Title}"/>
                    <TextBlock x:Name="StatsTopActivityTextBlock" Text="None" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard4Text}" Margin="0 3 0 0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 8. Bottom Action Bar -->
        <Grid Grid.Row="7" Margin="0 10 0 0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="📅 Work Planner / Goals"
                        Style="{StaticResource PrimaryButton}"
                        Width="155"
                        Margin="0 0 6 0"
                        Click="OpenCalendarPlanner_Click"/>
                <Button Content="📁 Manage Projects"
                        Width="140"
                        Margin="0 0 6 0"
                        Click="AddNewProjectButton_Click"/>
                <Button Content="🏷️ Manage Activities"
                        Width="150"
                        Margin="0 0 6 0"
                        Click="AddNewActivityButton_Click"/>
                <Button Content="📊 Analytics"
                        Width="95"
                        Click="AnalyticsButton_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DeleteSelectedButton"
                        Content="🗑 Delete Selected"
                        Style="{StaticResource GhostDangerButton}"
                        Width="130"
                        Margin="0 0 6 0"
                        Click="DeleteSelectedButton_Click"/>
                <Button Content="📥 Export CSV"
                        Width="105"
                        Click="ExportButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
