<Window x:Class="VitorsWeeklyWorkTracking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Freelance Work Tracker"
        Height="720"
        Width="1040"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.WindowBackground}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Active Tracker Card -->
            <RowDefinition Height="Auto"/>
            <!-- Filter Bar Card -->
            <RowDefinition Height="Auto"/>
            <!-- Session Log DataGrid Card -->
            <RowDefinition Height="*"/>
            <!-- Summary Stats Card -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Bar: Logo, Title, Live Status Badge, Theme Selector -->
        <Grid Grid.Row="0" Margin="0 0 0 14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏱️" FontSize="18" Margin="0 0 6 0" VerticalAlignment="Center"/>
                    <TextBlock Text="Freelance Work Tracker" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Track hours, manage projects &amp; analyze your work" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="26 2 0 0"/>
            </StackPanel>

            <!-- Center Live Status Badge -->
            <Border Grid.Column="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="14 5"
                    Margin="10 0">
                <TextBlock x:Name="StatusTextBlock"
                           Text="Status: Idle"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource Theme.ForegroundMuted}"/>
            </Border>

            <!-- Right Theme Switcher -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🎨 Theme:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 6 0" VerticalAlignment="Center"/>
                <ComboBox x:Name="ThemeComboBox"
                          Width="180"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="ThemeComboBox_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <!-- 2. Active Tracker Card -->
        <Border Grid.Row="1"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14 12"
                Margin="0 0 0 12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Inputs & Controls -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Project Selector -->
                    <TextBlock Text="Project:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 6 0" Foreground="{DynamicResource Theme.Foreground}"/>
                    <ComboBox x:Name="ProjectComboBox"
                              DisplayMemberPath="Name"
                              Width="145"
                              Margin="0 0 4 0"/>
                    <Button x:Name="AddProjectQuickButton"
                            Content="+"
                            ToolTip="Add / Manage Projects"
                            FontWeight="Bold"
                            FontSize="13"
                            Width="26"
                            Height="28"
                            Padding="0"
                            Margin="0 0 10 0"
                            Click="AddNewProjectButton_Click"/>

                    <!-- Activity Selector -->
                    <TextBlock Text="Activity:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 6 0" Foreground="{DynamicResource Theme.Foreground}"/>
                    <ComboBox x:Name="ActivityComboBox"
                              DisplayMemberPath="Name"
                              IsEditable="True"
                              Width="135"
                              Margin="0 0 4 0"/>
                    <Button x:Name="AddActivityQuickButton"
                            Content="+"
                            ToolTip="Add / Manage Activities"
                            FontWeight="Bold"
                            FontSize="13"
                            Width="26"
                            Height="28"
                            Padding="0"
                            Margin="0 0 10 0"
                            Click="AddNewActivityButton_Click"/>

                    <!-- Description Input -->
                    <TextBlock Text="Task:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 6 0" Foreground="{DynamicResource Theme.Foreground}"/>
                    <TextBox x:Name="DescriptionTextBox"
                             Width="160"
                             Margin="0 0 12 0"/>

                    <!-- Timer Buttons -->
                    <Button x:Name="StartButton"
                            Content="▶ Start"
                            Style="{StaticResource PrimaryButton}"
                            Width="75"
                            Height="28"
                            Margin="0 0 6 0"
                            Click="StartButton_Click"/>

                    <Button x:Name="StopButton"
                            Content="⏹ Stop"
                            Width="75"
                            Height="28"
                            Margin="0 0 6 0"
                            Click="StopButton_Click"
                            IsEnabled="False"/>

                    <Button x:Name="SaveEntryButton"
                            Content="✔ Save"
                            Style="{StaticResource SuccessButton}"
                            Width="75"
                            Height="28"
                            Margin="0 0 6 0"
                            Click="SaveEntryButton_Click"
                            Visibility="Collapsed"/>

                    <Button x:Name="DiscardButton"
                            Content="✖ Discard"
                            Style="{StaticResource GhostDangerButton}"
                            Width="75"
                            Height="28"
                            Click="DiscardButton_Click"
                            Visibility="Collapsed"/>
                </WrapPanel>

                <!-- Row 2: Notes Area -->
                <Grid Grid.Row="1" Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Notes:" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0 5 10 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                    <TextBox x:Name="NoteTextBox"
                             Grid.Column="1"
                             Height="42"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Filter Bar Card -->
        <Border Grid.Row="2"
                Background="{DynamicResource Theme.CardBackgroundAlt}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12 8"
                Margin="0 0 0 10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="🔍 Filter:" FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 10 0" Foreground="{DynamicResource Theme.Foreground}"/>

                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                <DatePicker x:Name="FilterStartDatePicker"
                            Width="115"
                            Margin="0 0 8 0"
                            SelectedDateChanged="Filter_Changed"/>

                <TextBlock Text="To:" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                <DatePicker x:Name="FilterEndDatePicker"
                            Width="115"
                            Margin="0 0 10 0"
                            SelectedDateChanged="Filter_Changed"/>

                <TextBlock Text="Project:" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                <ComboBox x:Name="FilterProjectComboBox"
                          Width="135"
                          Margin="0 0 10 0"
                          SelectionChanged="Filter_Changed"/>

                <TextBlock Text="Activity:" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                <ComboBox x:Name="FilterActivityComboBox"
                          Width="135"
                          Margin="0 0 10 0"
                          SelectionChanged="Filter_Changed"/>

                <Button Content="Today"
                        Width="55"
                        Height="28"
                        Margin="0 0 4 0"
                        Click="TodayButton_Click"/>

                <Button Content="Show All"
                        Width="68"
                        Height="28"
                        Click="ShowAllButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- 4. Session Log DataGrid Card -->
        <Border Grid.Row="3"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0"
                ClipToBounds="True">
            <DataGrid x:Name="EntriesDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      BorderThickness="0"
                      PreviewKeyDown="EntriesDataGrid_PreviewKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="150"/>
                    <DataGridTextColumn Header="Activity" Binding="{Binding Activity}" Width="130"/>
                    <DataGridTextColumn Header="Description / Task" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat=\{0:HH:mm:ss\}}" Width="85"/>
                    <DataGridTextColumn Header="End" Binding="{Binding EndTime, StringFormat=\{0:HH:mm:ss\}}" Width="85"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration, StringFormat=\{0:hh\\:mm\\:ss\}}" Width="85"/>
                    <DataGridTemplateColumn Header="Action" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete"
                                        Style="{StaticResource GhostDangerButton}"
                                        FontSize="11"
                                        Padding="4 2"
                                        Margin="2"
                                        Click="DeleteEntryButton_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 5. Summary Statistics Bar (4 KPI Cards) -->
        <Grid Grid.Row="4" Margin="0 10 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Time -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Theme.StatCard1Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard1Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="0 0 4 0">
                <StackPanel>
                    <TextBlock Text="TOTAL TIME WORKED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Title}"/>
                    <TextBlock x:Name="StatsTotalTimeTextBlock" Text="0h 00m 00s" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Text}" Margin="0 3 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Total Sessions -->
            <Border Grid.Column="1"
                    Background="{DynamicResource Theme.StatCard2Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard2Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="2 0 2 0">
                <StackPanel>
                    <TextBlock Text="TOTAL SESSIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard2Title}"/>
                    <TextBlock x:Name="StatsTotalSessionsTextBlock" Text="0 sessions" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard2Text}" Margin="0 3 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Top Project -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Theme.StatCard3Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard3Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="2 0 2 0">
                <StackPanel>
                    <TextBlock Text="TOP PROJECT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard3Title}"/>
                    <TextBlock x:Name="StatsTopProjectTextBlock" Text="None" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard3Text}" Margin="0 3 0 0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Top Activity -->
            <Border Grid.Column="3"
                    Background="{DynamicResource Theme.StatCard4Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard4Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="4 0 0 0">
                <StackPanel>
                    <TextBlock Text="TOP ACTIVITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard4Title}"/>
                    <TextBlock x:Name="StatsTopActivityTextBlock" Text="None" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard4Text}" Margin="0 3 0 0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 6. Bottom Action Bar -->
        <Grid Grid.Row="5" Margin="0 10 0 0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="📁 Manage Projects"
                        Width="135"
                        Margin="0 0 8 0"
                        Click="AddNewProjectButton_Click"/>
                <Button Content="🏷️ Manage Activities"
                        Width="140"
                        Margin="0 0 8 0"
                        Click="AddNewActivityButton_Click"/>
                <Button Content="📊 Analytics"
                        Style="{StaticResource PrimaryButton}"
                        Width="110"
                        Click="AnalyticsButton_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DeleteSelectedButton"
                        Content="🗑 Delete Selected"
                        Style="{StaticResource GhostDangerButton}"
                        Width="130"
                        Margin="0 0 8 0"
                        Click="DeleteSelectedButton_Click"/>
                <Button Content="📥 Export CSV"
                        Width="120"
                        Click="ExportButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
