<Window x:Class="VitorsWeeklyWorkTracking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VitorsWeeklyWorkTracking.Controls"
        Title="Freelance Work Tracker"
        Height="780"
        Width="1120"
        MinHeight="660"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Background="{DynamicResource Theme.WindowBackground}">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="AppTaskbarItemInfo"/>
    </Window.TaskbarItemInfo>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Active Tracker & Alert Card -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Animated Art & Focus Companion Card -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Filter Bar Card -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Session Log DataGrid Card -->
            <RowDefinition Height="*"/>
            <!-- 5: Summary Stats Card -->
            <RowDefinition Height="Auto"/>
            <!-- 6: Bottom Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Bar: Logo, Title, Live Status Badge, Mini Overlay & Theme Selector -->
        <Grid Grid.Row="0" Margin="0 0 0 14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏱️" FontSize="18" Margin="0 0 6 0" VerticalAlignment="Center"/>
                    <TextBlock Text="Freelance Work Tracker" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Track hours, manage projects &amp; analyze your work" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="26 2 0 0"/>
            </StackPanel>

            <!-- Center Live Status Badge -->
            <Border Grid.Column="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="14 5"
                    Margin="10 0">
                <TextBlock x:Name="StatusTextBlock"
                           Text="Status: Idle"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource Theme.ForegroundMuted}"/>
            </Border>

            <!-- Right Controls: Mini Timer Corner Selector & Theme Switcher -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Companion Toggle Button -->
                <Button x:Name="CompanionQuickToggleButton"
                        Content="🎨 Art Companion"
                        ToolTip="Toggle Animated Art &amp; Game Companion"
                        Height="28"
                        Padding="8 0"
                        FontSize="11"
                        Margin="0 0 10 0"
                        Click="CompanionQuickToggleButton_Click"/>

                <!-- Mini Floating Timer Options -->
                <TextBlock Text="🗗 Mini Timer:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 6 0" VerticalAlignment="Center"/>
                <ComboBox x:Name="MiniCornerComboBox"
                          Width="130"
                          Margin="0 0 8 0"
                          SelectionChanged="MiniCornerComboBox_SelectionChanged"/>
                
                <Button x:Name="MiniOverlayQuickButton"
                        Content="↘ Mini View"
                        ToolTip="Switch to Floating Corner Widget"
                        Height="28"
                        Padding="8 0"
                        FontSize="11"
                        Margin="0 0 14 0"
                        Click="MiniOverlayQuickButton_Click"/>

                <!-- Theme Switcher -->
                <TextBlock Text="🎨 Theme:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 6 0" VerticalAlignment="Center"/>
                <ComboBox x:Name="ThemeComboBox"
                          Width="175"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="ThemeComboBox_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <!-- 2. Active Tracker Hero Card & Alert Banner -->
        <StackPanel Grid.Row="1" Margin="0 0 0 12">
            <!-- Rest & Focus Interval Alert Banner -->
            <Border x:Name="IntervalAlertBanner"
                    Background="{DynamicResource Theme.CardBackgroundAlt}"
                    BorderBrush="{DynamicResource Theme.Primary}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="14 10"
                    Margin="0 0 0 10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="IntervalAlertIcon" Text="🔔" FontSize="26" VerticalAlignment="Center" Margin="0 0 12 0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="IntervalAlertTitle" Text="🔔 Rest Time! Great Job!" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}"/>
                        <TextBlock x:Name="IntervalAlertMessage" Text="You've finished your 25-minute focus session. Time for a 5-minute break!" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 2 0 2" TextWrapping="Wrap"/>
                        <TextBlock x:Name="IntervalAlertTip" Text="💧 Grab a refreshing glass of water and hydrate!" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Success}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12 0 0 0">
                        <Button x:Name="IntervalAlertPrimaryAction"
                                Content="☕ Start Rest"
                                Style="{StaticResource SuccessButton}"
                                Height="28"
                                Padding="12 0"
                                FontSize="11"
                                FontWeight="Bold"
                                Margin="0 0 6 0"
                                Click="IntervalAlertPrimaryAction_Click"/>
                        <Button x:Name="IntervalAlertDismissButton"
                                Content="✕ Dismiss"
                                Style="{StaticResource GhostButton}"
                                Height="28"
                                Padding="10 0"
                                FontSize="11"
                                Click="IntervalAlertDismissButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hero Card -->
            <Border Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left Hero Section: Big Circular Button & Prominent Digital Timer & Status -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center Divider -->
                    <ColumnDefinition Width="1"/>
                    <!-- Right Input Fields Section -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Hero Section -->
                <Grid Grid.Column="0" Margin="0 0 18 0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Big Circular Start / Stop Button Slot -->
                        <Grid Width="100" Height="100" Margin="4">
                            <!-- Start Button -->
                            <Button x:Name="StartButton"
                                    Style="{StaticResource CircularStartButton}"
                                    Click="StartButton_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="▶" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="2 0 0 1"/>
                                    <TextBlock Text="START" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Stop Button -->
                            <Button x:Name="StopButton"
                                    Style="{StaticResource CircularStopButton}"
                                    Click="StopButton_Click"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⏹" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 1"/>
                                    <TextBlock Text="STOP" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Prominent Timer & Status Details -->
                        <StackPanel VerticalAlignment="Center" Margin="16 0 8 0" MinWidth="200" MaxWidth="240">
                            <!-- Prominent Status Badge / Pill -->
                            <Border x:Name="HeroStatusBadge"
                                    HorizontalAlignment="Left"
                                    CornerRadius="10"
                                    Padding="8 3"
                                    Background="{DynamicResource Theme.CardBackgroundAlt}"
                                    BorderBrush="{DynamicResource Theme.CardBorder}"
                                    BorderThickness="1"
                                    Margin="0 0 0 4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="HeroStatusDot" Width="7" Height="7" Fill="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 5 0"/>
                                    <TextBlock x:Name="HeroStatusBadgeText"
                                               Text="READY"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                </StackPanel>
                            </Border>

                            <!-- Prominent Big Digital Clock & Mode Toggle Row -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 2">
                                <TextBlock x:Name="TimerDisplayTextBlock"
                                           Text="00:00:00"
                                           FontFamily="Consolas, Segoe UI, sans-serif"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Theme.Foreground}"
                                           Cursor="Hand"
                                           ToolTip="Click to toggle Count Up / Count Down mode"
                                           MouseLeftButtonUp="TimerDisplayTextBlock_MouseLeftButtonUp"/>

                                <Button x:Name="TimerModeToggleButton"
                                        Content="⏱ UP"
                                        ToolTip="Toggle Count Up / Count Down mode"
                                        Style="{StaticResource GhostButton}"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Padding="6 2"
                                        Height="22"
                                        Margin="8 0 0 0"
                                        VerticalAlignment="Center"
                                        Click="TimerModeToggleButton_Click"/>
                            </StackPanel>

                            <!-- Goal Progress Bar (Shown when a Goal is set) -->
                            <StackPanel x:Name="GoalProgressContainer" Margin="0 0 0 4" Visibility="Collapsed">
                                <ProgressBar x:Name="GoalProgressBar" Height="6" Margin="0 0 0 2"/>
                                <TextBlock x:Name="GoalStatsTextBlock"
                                           Text="0% • 00:00 / 25:00 (25m left)"
                                           FontSize="10"
                                           Foreground="{DynamicResource Theme.ForegroundMuted}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Prominent Status Headline -->
                            <TextBlock x:Name="HeroStatusHeadline"
                                       Text="Ready to Track"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Foreground}"
                                       MaxWidth="230"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Prominent Status Subhead -->
                            <TextBlock x:Name="HeroStatusSubhead"
                                       Text="Select project &amp; activity to begin"
                                       FontSize="10"
                                       Foreground="{DynamicResource Theme.ForegroundMuted}"
                                       MaxWidth="230"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Vertical Divider -->
                <Rectangle Grid.Column="1" Fill="{DynamicResource Theme.CardBorder}" Margin="0 2"/>

                <!-- Right Input Fields Section -->
                <Grid Grid.Column="2" Margin="18 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Project, Activity, and Goal Selectors -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <!-- Project Field -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="📁 Project" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ProjectComboBox"
                                          DisplayMemberPath="Name"
                                          HorizontalAlignment="Stretch"/>
                                <Button x:Name="AddProjectQuickButton"
                                        Grid.Column="1"
                                        Content="+"
                                        ToolTip="Add / Manage Projects"
                                        FontWeight="Bold"
                                        FontSize="13"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Margin="4 0 0 0"
                                        Click="AddNewProjectButton_Click"/>
                            </Grid>
                        </Grid>

                        <!-- Activity Field -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="🏷️ Activity" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ActivityComboBox"
                                          DisplayMemberPath="Name"
                                          IsEditable="True"
                                          HorizontalAlignment="Stretch"/>
                                <Button x:Name="AddActivityQuickButton"
                                        Grid.Column="1"
                                        Content="+"
                                        ToolTip="Add / Manage Activities"
                                        FontWeight="Bold"
                                        FontSize="13"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Margin="4 0 0 0"
                                        Click="AddNewActivityButton_Click"/>
                            </Grid>
                        </Grid>

                        <!-- Goal Selector Field -->
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="🎯 Goal / Timer Mode" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                            <ComboBox x:Name="GoalComboBox"
                                      Grid.Row="1"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="GoalComboBox_SelectionChanged"/>
                        </Grid>
                    </Grid>

                    <!-- Row 1: Task Description & Notes -->
                    <Grid Grid.Row="1" Margin="0 8 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Task Description -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="📝 Task Description" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                            <TextBox x:Name="DescriptionTextBox"
                                     Grid.Row="1"
                                     Height="40"
                                     VerticalContentAlignment="Center"/>
                        </Grid>

                        <!-- Notes Area with Styled ScrollBar and Up/Down Buttons -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="💬 Notes" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                            <TextBox x:Name="NoteTextBox"
                                     Grid.Row="1"
                                     Height="40"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>

                    <!-- Row 2: Review & Save Action Banner (Displayed after stopping timer) -->
                    <Border x:Name="ReviewActionBar"
                            Grid.Row="2"
                            Visibility="Collapsed"
                            Background="{DynamicResource Theme.CardBackgroundAlt}"
                            BorderBrush="{DynamicResource Theme.Primary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10 6"
                            Margin="0 8 0 0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="⏱️ Session Recorded — Ready to Save" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme.Foreground}"/>
                                <TextBlock Text="Review project and notes, then save to work log below." FontSize="10" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="SaveEntryButton"
                                        Content="✔ Save Entry"
                                        Style="{StaticResource SuccessButton}"
                                        Height="28"
                                        Padding="14 0"
                                        FontWeight="Bold"
                                        FontSize="11"
                                        Margin="0 0 6 0"
                                        Click="SaveEntryButton_Click"/>

                                <Button x:Name="DiscardButton"
                                        Content="✖ Discard"
                                        Style="{StaticResource GhostDangerButton}"
                                        Height="28"
                                        Padding="10 0"
                                        FontSize="11"
                                        Click="DiscardButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            </Border>
        </StackPanel>

        <!-- 3. Animated Art & Focus Companion Card -->
        <controls:AsciiCompanionControl x:Name="CompanionControl"
                                         Grid.Row="2"
                                         Margin="0 0 0 12"/>

        <!-- 4. Filter Bar Card -->
        <Border Grid.Row="3"
                Background="{DynamicResource Theme.CardBackgroundAlt}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12 8"
                Margin="0 0 0 10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="🔍 Filter:" FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 10 0" Foreground="{DynamicResource Theme.Foreground}"/>

                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                <DatePicker x:Name="FilterStartDatePicker"
                            Width="115"
                            Margin="0 0 8 0"
                            SelectedDateChanged="Filter_Changed"/>

                <TextBlock Text="To:" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                <DatePicker x:Name="FilterEndDatePicker"
                            Width="115"
                            Margin="0 0 10 0"
                            SelectedDateChanged="Filter_Changed"/>

                <TextBlock Text="Project:" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                <ComboBox x:Name="FilterProjectComboBox"
                          Width="135"
                          Margin="0 0 10 0"
                          SelectionChanged="Filter_Changed"/>

                <TextBlock Text="Activity:" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                <ComboBox x:Name="FilterActivityComboBox"
                          Width="135"
                          Margin="0 0 10 0"
                          SelectionChanged="Filter_Changed"/>

                <Button Content="Today"
                        Width="80"
                        Height="28"
                        Margin="0 0 4 0"
                        Click="TodayButton_Click"/>

                <Button Content="Show All"
                        Width="80"
                        Height="28"
                        Click="ShowAllButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- 5. Session Log DataGrid Card -->
        <Border Grid.Row="4"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0"
                ClipToBounds="True">
            <DataGrid x:Name="EntriesDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      BorderThickness="0"
                      PreviewKeyDown="EntriesDataGrid_PreviewKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="150"/>
                    <DataGridTextColumn Header="Activity" Binding="{Binding Activity}" Width="130"/>
                    <DataGridTextColumn Header="Description / Task" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat=\{0:HH:mm:ss\}}" Width="85"/>
                    <DataGridTextColumn Header="End" Binding="{Binding EndTime, StringFormat=\{0:HH:mm:ss\}}" Width="85"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration, StringFormat=\{0:hh\\:mm\\:ss\}}" Width="85"/>
                    <DataGridTemplateColumn Header="Action" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete"
                                        Style="{StaticResource GhostDangerButton}"
                                        FontSize="11"
                                        Padding="4 2"
                                        Margin="2"
                                        Click="DeleteEntryButton_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 6. Summary Statistics Bar (4 KPI Cards) -->
        <Grid Grid.Row="5" Margin="0 10 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Time -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Theme.StatCard1Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard1Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="0 0 4 0">
                <StackPanel>
                    <TextBlock Text="TOTAL TIME WORKED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Title}"/>
                    <TextBlock x:Name="StatsTotalTimeTextBlock" Text="0h 00m 00s" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Text}" Margin="0 3 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Total Sessions -->
            <Border Grid.Column="1"
                    Background="{DynamicResource Theme.StatCard2Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard2Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="2 0 2 0">
                <StackPanel>
                    <TextBlock Text="TOTAL SESSIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard2Title}"/>
                    <TextBlock x:Name="StatsTotalSessionsTextBlock" Text="0 sessions" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard2Text}" Margin="0 3 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Top Project -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Theme.StatCard3Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard3Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="2 0 2 0">
                <StackPanel>
                    <TextBlock Text="TOP PROJECT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard3Title}"/>
                    <TextBlock x:Name="StatsTopProjectTextBlock" Text="None" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard3Text}" Margin="0 3 0 0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Top Activity -->
            <Border Grid.Column="3"
                    Background="{DynamicResource Theme.StatCard4Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard4Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="4 0 0 0">
                <StackPanel>
                    <TextBlock Text="TOP ACTIVITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard4Title}"/>
                    <TextBlock x:Name="StatsTopActivityTextBlock" Text="None" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard4Text}" Margin="0 3 0 0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 7. Bottom Action Bar -->
        <Grid Grid.Row="6" Margin="0 10 0 0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="📁 Manage Projects"
                        Width="135"
                        Margin="0 0 8 0"
                        Click="AddNewProjectButton_Click"/>
                <Button Content="🏷️ Manage Activities"
                        Width="140"
                        Margin="0 0 8 0"
                        Click="AddNewActivityButton_Click"/>
                <Button Content="📊 Analytics"
                        Style="{StaticResource PrimaryButton}"
                        Width="110"
                        Click="AnalyticsButton_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DeleteSelectedButton"
                        Content="🗑 Delete Selected"
                        Style="{StaticResource GhostDangerButton}"
                        Width="130"
                        Margin="0 0 8 0"
                        Click="DeleteSelectedButton_Click"/>
                <Button Content="📥 Export CSV"
                        Width="120"
                        Click="ExportButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
