<Window x:Class="VitorsWeeklyWorkTracking.TaskDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Details"
        Icon="VitorWeeklyWorkTracking.ico"
        Width="500"
        Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Details Content -->
                <RowDefinition Height="*"/>
                <!-- 2: Action Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Theme.CardBackground}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14 12"
                    Margin="0 0 0 14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📋" FontSize="26" VerticalAlignment="Center" Margin="0 0 12 0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Task &amp; Session Details" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}"/>
                        <TextBlock Text="Full breakdown of recorded task parameters, times, and notes" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 2 0 0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. Content Card -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0 0 0 14">
                <StackPanel Margin="0 0 4 0">
                    <!-- Project & Activity Badges -->
                    <WrapPanel Margin="0 0 0 10">
                        <Border Background="{DynamicResource Theme.CardBackgroundAlt}"
                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10 4"
                                Margin="0 0 8 4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁 " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProjectBadgeText"
                                           Text="Project Name"
                                           FontWeight="Bold"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Theme.Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ActivityBadgeBorder"
                                Background="{DynamicResource Theme.CardBackgroundAlt}"
                                BorderBrush="{DynamicResource Theme.CardBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10 4"
                                Margin="0 0 8 4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏷️ " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ActivityBadgeText"
                                           Text="Activity Name"
                                           FontWeight="SemiBold"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Theme.ForegroundMuted}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Task Description -->
                    <Border Background="{DynamicResource Theme.CardBackground}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12 10"
                            Margin="0 0 0 12">
                        <StackPanel>
                            <TextBlock Text="TASK / DESCRIPTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 4"/>
                            <TextBlock x:Name="DescriptionText"
                                       Text="No description specified"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Foreground}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Timing Information -->
                    <Border Background="{DynamicResource Theme.CardBackgroundAlt}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12 10"
                            Margin="0 0 0 12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Date -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0 0 6 8">
                                <TextBlock Text="📅 DATE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                <TextBlock x:Name="DateText" Text="2026-09-30" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}" Margin="0 2 0 0"/>
                            </StackPanel>

                            <!-- Duration -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="6 0 0 8">
                                <TextBlock Text="⏳ DURATION" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                <TextBlock x:Name="DurationText" Text="00:00:00 (0.00 hrs)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Theme.Primary}" Margin="0 2 0 0"/>
                            </StackPanel>

                            <!-- Start Time -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0 0 6 0">
                                <TextBlock Text="🟢 START TIME" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                <TextBlock x:Name="StartTimeText" Text="09:00:00" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}" Margin="0 2 0 0"/>
                            </StackPanel>

                            <!-- End Time -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="6 0 0 0">
                                <TextBlock Text="🔴 END TIME" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                <TextBlock x:Name="EndTimeText" Text="10:30:00" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}" Margin="0 2 0 0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Notes Section -->
                    <Border Background="{DynamicResource Theme.CardBackground}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12 10"
                            Margin="0 0 0 4">
                        <StackPanel>
                            <TextBlock Text="📝 NOTES &amp; REMARKS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 0 6"/>
                            <TextBlock x:Name="NotesText"
                                       Text="(No notes added for this task)"
                                       FontSize="12"
                                       LineHeight="18"
                                       Foreground="{DynamicResource Theme.Foreground}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. Action Footer -->
            <Grid Grid.Row="2" Margin="0 4 0 0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="CopyNotesButton"
                            Content="📋 Copy Notes"
                            Style="{StaticResource GhostButton}"
                            Height="32"
                            Padding="10 0"
                            Click="CopyNotesButton_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="EditTaskButton"
                            Content="✏️ Edit Task"
                            Style="{StaticResource PrimaryButton}"
                            Height="32"
                            Padding="14 0"
                            Margin="0 0 8 0"
                            Click="EditTaskButton_Click"/>
                    <Button Content="Close"
                            Width="80"
                            Height="32"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
