<Window x:Class="VitorsWeeklyWorkTracking.CalendarPlannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Work Planner &amp; Goal Calendar"
        Icon="VitorWeeklyWorkTracking.ico"
        Height="720"
        Width="980"
        MinHeight="580"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid Margin="14 12" MinHeight="560">
        <Grid.RowDefinitions>
            <!-- 0: Header & Week Navigation -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Weekly Goal KPI Cards & Quick Templates -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Main Content Area (Tabs: Week Board, Detailed List, Project Breakdown) -->
            <RowDefinition Height="*"/>
            <!-- 3: Bottom Action / Close Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header & Week Navigation Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource Theme.CardBackground}"
                BorderBrush="{DynamicResource Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14 10"
                Margin="0 0 0 12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Title on Left, Week Range Badge on Right -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📅" FontSize="18" Margin="0 0 6 0" VerticalAlignment="Center"/>
                        <TextBlock Text="Work Planner &amp; Weekly Goals" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.Foreground}" VerticalAlignment="Center"/>
                        <TextBlock Text="• Schedule project hours (Mon–Sun) &amp; track goals" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" VerticalAlignment="Center" Margin="8 2 0 0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource Theme.CardBackgroundAlt}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10 4"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="WeekRangeLabel" Text="Mon, 28 Sep - Sun, 04 Oct 2026" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Theme.Primary}"/>
                    </Border>
                </Grid>

                <!-- Row 1: Week Navigation & Jump To -->
                <WrapPanel Grid.Row="1" Margin="0 8 0 0" VerticalAlignment="Center">
                    <Button Content="◀ Prev Week" Width="85" Height="26" Margin="0 0 4 0" Click="PrevWeekButton_Click"/>
                    <Button Content="This Week" Width="80" Height="26" Margin="0 0 4 0" Style="{StaticResource PrimaryButton}" Click="ThisWeekButton_Click"/>
                    <Button Content="Next Week ▶" Width="85" Height="26" Margin="0 0 12 0" Click="NextWeekButton_Click"/>

                    <TextBlock Text="Jump to Date:" VerticalAlignment="Center" Foreground="{DynamicResource Theme.ForegroundMuted}" Margin="0 0 6 0"/>
                    <DatePicker x:Name="WeekDatePicker" Width="120" Height="26" SelectedDateChanged="WeekDatePicker_SelectedDateChanged"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 1. Weekly Goal KPI Cards & Quick Tools -->
        <Grid Grid.Row="1" Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Planned Hours -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Theme.StatCard1Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard1Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="0 0 4 0">
                <StackPanel>
                    <TextBlock Text="WEEKLY PLANNED GOAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Title}"/>
                    <TextBlock x:Name="WeeklyPlannedHoursText" Text="0.0 hrs" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard1Text}" Margin="0 3 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Total Actual Hours Worked -->
            <Border Grid.Column="1"
                    Background="{DynamicResource Theme.StatCard2Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard2Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="2 0 2 0">
                <StackPanel>
                    <TextBlock Text="HOURS WORKED (MON-SUN)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard2Title}"/>
                    <TextBlock x:Name="WeeklyActualHoursText" Text="0.0 hrs" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard2Text}" Margin="0 3 0 0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Goal Completion Progress -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Theme.StatCard3Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard3Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12 8"
                    Margin="2 0 2 0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="GOAL COMPLETION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard3Title}"/>
                        <TextBlock x:Name="WeeklyRemainingText" Text="0.0h left" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Theme.StatCard3Text}" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock x:Name="WeeklyProgressPctText" Text="0.0%" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard3Text}" Margin="0 3 0 2"/>
                    <ProgressBar x:Name="WeeklyProgressBar" Height="4" Maximum="100" Value="0" Foreground="{DynamicResource Theme.StatCard3Text}"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Quick Planning Templates -->
            <Border Grid.Column="3"
                    Background="{DynamicResource Theme.StatCard4Bg}"
                    BorderBrush="{DynamicResource Theme.StatCard4Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10 6"
                    Margin="4 0 0 0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="QUICK TEMPLATES (MON-FRI)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Theme.StatCard4Title}" Margin="0 0 0 4"/>
                    <WrapPanel>
                        <Button Content="⚡ 8h/day (40h)"
                                Style="{StaticResource GhostButton}"
                                FontSize="10"
                                Padding="5 2"
                                Height="22"
                                Margin="0 0 4 4"
                                Click="Template40Hours_Click"/>
                        <Button Content="⚡ 5h/day (25h)"
                                Style="{StaticResource GhostButton}"
                                FontSize="10"
                                Padding="5 2"
                                Height="22"
                                Margin="0 0 4 4"
                                Click="Template25Hours_Click"/>
                        <Button Content="📋 Copy Prev Week"
                                Style="{StaticResource GhostButton}"
                                FontSize="10"
                                Padding="5 2"
                                Height="22"
                                Margin="0 0 4 4"
                                Click="CopyPrevWeekButton_Click"/>
                        <Button Content="🗑 Clear Week"
                                Style="{StaticResource GhostDangerButton}"
                                FontSize="10"
                                Padding="5 2"
                                Height="22"
                                Margin="0 0 0 4"
                                Click="ClearWeekButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Main Content Tabs -->
        <TabControl Grid.Row="2" x:Name="PlannerTabControl" SelectionChanged="PlannerTabControl_SelectionChanged">
            <!-- Tab 1: 7-Day Weekly Schedule Board -->
            <TabItem Header="📅 7-Day Schedule Board">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <!-- Top: Add/Edit Plan Inline Toolbar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Center: 7 Day Columns (Monday to Sunday) -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Add / Edit Plan Quick Bar -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource Theme.CardBackgroundAlt}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12 8"
                            Margin="0 0 0 8">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock x:Name="EditorHeaderLabel" Text="➕ Plan Work Session:" FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 8 0" Foreground="{DynamicResource Theme.Foreground}"/>

                            <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0 0 4 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                            <DatePicker x:Name="PlanDatePicker" Width="110" Margin="0 0 8 0" SelectedDateChanged="PlanDatePicker_SelectedDateChanged"/>

                            <TextBlock Text="Project:" VerticalAlignment="Center" Margin="0 0 4 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                            <ComboBox x:Name="PlanProjectComboBox" Width="125" Margin="0 0 8 0"/>

                            <TextBlock Text="Activity:" VerticalAlignment="Center" Margin="0 0 4 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                            <ComboBox x:Name="PlanActivityComboBox" Width="110" Margin="0 0 8 0"/>

                            <TextBlock Text="Planned Hours:" VerticalAlignment="Center" Margin="0 0 4 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                            <TextBox x:Name="PlanHoursTextBox" Width="44" Margin="0 0 4 0" Text="4.0" Padding="4 2" TextAlignment="Center"/>

                            <!-- Quick Hours presets -->
                            <Button Content="1h" Style="{StaticResource GhostButton}" Height="24" Width="26" Padding="0" Margin="0 0 2 0" Click="HoursPreset_Click" Tag="1.0"/>
                            <Button Content="2h" Style="{StaticResource GhostButton}" Height="24" Width="26" Padding="0" Margin="0 0 2 0" Click="HoursPreset_Click" Tag="2.0"/>
                            <Button Content="4h" Style="{StaticResource GhostButton}" Height="24" Width="26" Padding="0" Margin="0 0 2 0" Click="HoursPreset_Click" Tag="4.0"/>
                            <Button Content="6h" Style="{StaticResource GhostButton}" Height="24" Width="26" Padding="0" Margin="0 0 2 0" Click="HoursPreset_Click" Tag="6.0"/>
                            <Button Content="8h" Style="{StaticResource GhostButton}" Height="24" Width="26" Padding="0" Margin="0 0 2 0" Click="HoursPreset_Click" Tag="8.0"/>

                            <TextBlock Text="Notes:" VerticalAlignment="Center" Margin="0 0 4 0" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                            <TextBox x:Name="PlanNoteTextBox" Width="120" Margin="0 0 8 0" Padding="4 2"/>

                            <Button x:Name="SavePlanButton"
                                    Content="💾 Save Plan"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="26"
                                    Padding="10 0"
                                    Margin="0 0 4 0"
                                    Click="SavePlanButton_Click"/>

                            <Button x:Name="CancelEditButton"
                                    Content="✕ Cancel"
                                    Style="{StaticResource GhostButton}"
                                    Height="26"
                                    Padding="8 0"
                                    Visibility="Collapsed"
                                    Click="CancelEditButton_Click"/>
                        </WrapPanel>
                    </Border>

                    <!-- 7 Day Columns (Monday to Sunday) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Day 0: Monday -->
                        <Border x:Name="Day0Border" Grid.Column="0" Tag="0" Cursor="Hand" MouseLeftButtonUp="DayBorder_MouseLeftButtonUp" Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0 0 3 0" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock x:Name="Day0NameText" Text="MONDAY" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme.Primary}"/>
                                        <TextBlock x:Name="Day0DateText" Text="28 Sep" FontSize="10" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                    </StackPanel>
                                    <Border x:Name="Day0SelectedBadge"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Theme.Primary}"
                                            CornerRadius="3"
                                            Padding="4 1"
                                            Visibility="Collapsed">
                                        <TextBlock Text="SELECTED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Theme.PrimaryForeground}"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0 4 0 6">
                                    <TextBlock x:Name="Day0StatsText" Text="Plan: 0.0h • Act: 0.0h" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}"/>
                                    <ProgressBar x:Name="Day0ProgressBar" Height="4" Maximum="100" Value="0" Margin="0 2 0 0" Foreground="{DynamicResource Theme.Primary}"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="Day0PlansPanel"/>
                                </ScrollViewer>
                                <Button x:Name="Day0AddPlanButton" Grid.Row="3" Content="➕ Add Plan" Style="{StaticResource GhostButton}" FontSize="10" Height="22" Margin="0 4 0 0" Click="DayAddPlan_Click" Tag="0"/>
                            </Grid>
                        </Border>

                        <!-- Day 1: Tuesday -->
                        <Border x:Name="Day1Border" Grid.Column="1" Tag="1" Cursor="Hand" MouseLeftButtonUp="DayBorder_MouseLeftButtonUp" Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="8" Margin="3 0 3 0" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock x:Name="Day1NameText" Text="TUESDAY" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme.Primary}"/>
                                        <TextBlock x:Name="Day1DateText" Text="29 Sep" FontSize="10" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                    </StackPanel>
                                    <Border x:Name="Day1SelectedBadge"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Theme.Primary}"
                                            CornerRadius="3"
                                            Padding="4 1"
                                            Visibility="Collapsed">
                                        <TextBlock Text="SELECTED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Theme.PrimaryForeground}"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0 4 0 6">
                                    <TextBlock x:Name="Day1StatsText" Text="Plan: 0.0h • Act: 0.0h" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}"/>
                                    <ProgressBar x:Name="Day1ProgressBar" Height="4" Maximum="100" Value="0" Margin="0 2 0 0" Foreground="{DynamicResource Theme.Primary}"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="Day1PlansPanel"/>
                                </ScrollViewer>
                                <Button x:Name="Day1AddPlanButton" Grid.Row="3" Content="➕ Add Plan" Style="{StaticResource GhostButton}" FontSize="10" Height="22" Margin="0 4 0 0" Click="DayAddPlan_Click" Tag="1"/>
                            </Grid>
                        </Border>

                        <!-- Day 2: Wednesday -->
                        <Border x:Name="Day2Border" Grid.Column="2" Tag="2" Cursor="Hand" MouseLeftButtonUp="DayBorder_MouseLeftButtonUp" Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="8" Margin="3 0 3 0" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock x:Name="Day2NameText" Text="WEDNESDAY" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme.Primary}"/>
                                        <TextBlock x:Name="Day2DateText" Text="30 Sep" FontSize="10" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                    </StackPanel>
                                    <Border x:Name="Day2SelectedBadge"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Theme.Primary}"
                                            CornerRadius="3"
                                            Padding="4 1"
                                            Visibility="Collapsed">
                                        <TextBlock Text="SELECTED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Theme.PrimaryForeground}"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0 4 0 6">
                                    <TextBlock x:Name="Day2StatsText" Text="Plan: 0.0h • Act: 0.0h" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}"/>
                                    <ProgressBar x:Name="Day2ProgressBar" Height="4" Maximum="100" Value="0" Margin="0 2 0 0" Foreground="{DynamicResource Theme.Primary}"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="Day2PlansPanel"/>
                                </ScrollViewer>
                                <Button x:Name="Day2AddPlanButton" Grid.Row="3" Content="➕ Add Plan" Style="{StaticResource GhostButton}" FontSize="10" Height="22" Margin="0 4 0 0" Click="DayAddPlan_Click" Tag="2"/>
                            </Grid>
                        </Border>

                        <!-- Day 3: Thursday -->
                        <Border x:Name="Day3Border" Grid.Column="3" Tag="3" Cursor="Hand" MouseLeftButtonUp="DayBorder_MouseLeftButtonUp" Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="8" Margin="3 0 3 0" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock x:Name="Day3NameText" Text="THURSDAY" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme.Primary}"/>
                                        <TextBlock x:Name="Day3DateText" Text="01 Oct" FontSize="10" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                    </StackPanel>
                                    <Border x:Name="Day3SelectedBadge"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Theme.Primary}"
                                            CornerRadius="3"
                                            Padding="4 1"
                                            Visibility="Collapsed">
                                        <TextBlock Text="SELECTED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Theme.PrimaryForeground}"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0 4 0 6">
                                    <TextBlock x:Name="Day3StatsText" Text="Plan: 0.0h • Act: 0.0h" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}"/>
                                    <ProgressBar x:Name="Day3ProgressBar" Height="4" Maximum="100" Value="0" Margin="0 2 0 0" Foreground="{DynamicResource Theme.Primary}"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="Day3PlansPanel"/>
                                </ScrollViewer>
                                <Button x:Name="Day3AddPlanButton" Grid.Row="3" Content="➕ Add Plan" Style="{StaticResource GhostButton}" FontSize="10" Height="22" Margin="0 4 0 0" Click="DayAddPlan_Click" Tag="3"/>
                            </Grid>
                        </Border>

                        <!-- Day 4: Friday -->
                        <Border x:Name="Day4Border" Grid.Column="4" Tag="4" Cursor="Hand" MouseLeftButtonUp="DayBorder_MouseLeftButtonUp" Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="8" Margin="3 0 3 0" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock x:Name="Day4NameText" Text="FRIDAY" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme.Primary}"/>
                                        <TextBlock x:Name="Day4DateText" Text="02 Oct" FontSize="10" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                    </StackPanel>
                                    <Border x:Name="Day4SelectedBadge"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Theme.Primary}"
                                            CornerRadius="3"
                                            Padding="4 1"
                                            Visibility="Collapsed">
                                        <TextBlock Text="SELECTED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Theme.PrimaryForeground}"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0 4 0 6">
                                    <TextBlock x:Name="Day4StatsText" Text="Plan: 0.0h • Act: 0.0h" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}"/>
                                    <ProgressBar x:Name="Day4ProgressBar" Height="4" Maximum="100" Value="0" Margin="0 2 0 0" Foreground="{DynamicResource Theme.Primary}"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="Day4PlansPanel"/>
                                </ScrollViewer>
                                <Button x:Name="Day4AddPlanButton" Grid.Row="3" Content="➕ Add Plan" Style="{StaticResource GhostButton}" FontSize="10" Height="22" Margin="0 4 0 0" Click="DayAddPlan_Click" Tag="4"/>
                            </Grid>
                        </Border>

                        <!-- Day 5: Saturday -->
                        <Border x:Name="Day5Border" Grid.Column="5" Tag="5" Cursor="Hand" MouseLeftButtonUp="DayBorder_MouseLeftButtonUp" Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="8" Margin="3 0 3 0" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock x:Name="Day5NameText" Text="SATURDAY" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundSubtle}"/>
                                        <TextBlock x:Name="Day5DateText" Text="03 Oct" FontSize="10" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                    </StackPanel>
                                    <Border x:Name="Day5SelectedBadge"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Theme.Primary}"
                                            CornerRadius="3"
                                            Padding="4 1"
                                            Visibility="Collapsed">
                                        <TextBlock Text="SELECTED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Theme.PrimaryForeground}"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0 4 0 6">
                                    <TextBlock x:Name="Day5StatsText" Text="Plan: 0.0h • Act: 0.0h" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}"/>
                                    <ProgressBar x:Name="Day5ProgressBar" Height="4" Maximum="100" Value="0" Margin="0 2 0 0" Foreground="{DynamicResource Theme.SecondaryBorder}"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="Day5PlansPanel"/>
                                </ScrollViewer>
                                <Button x:Name="Day5AddPlanButton" Grid.Row="3" Content="➕ Add Plan" Style="{StaticResource GhostButton}" FontSize="10" Height="22" Margin="0 4 0 0" Click="DayAddPlan_Click" Tag="5"/>
                            </Grid>
                        </Border>

                        <!-- Day 6: Sunday -->
                        <Border x:Name="Day6Border" Grid.Column="6" Tag="6" Cursor="Hand" MouseLeftButtonUp="DayBorder_MouseLeftButtonUp" Background="{DynamicResource Theme.CardBackground}" BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1" CornerRadius="8" Margin="3 0 0 0" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock x:Name="Day6NameText" Text="SUNDAY" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Theme.ForegroundSubtle}"/>
                                        <TextBlock x:Name="Day6DateText" Text="04 Oct" FontSize="10" Foreground="{DynamicResource Theme.ForegroundMuted}"/>
                                    </StackPanel>
                                    <Border x:Name="Day6SelectedBadge"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Theme.Primary}"
                                            CornerRadius="3"
                                            Padding="4 1"
                                            Visibility="Collapsed">
                                        <TextBlock Text="SELECTED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Theme.PrimaryForeground}"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0 4 0 6">
                                    <TextBlock x:Name="Day6StatsText" Text="Plan: 0.0h • Act: 0.0h" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Foreground}"/>
                                    <ProgressBar x:Name="Day6ProgressBar" Height="4" Maximum="100" Value="0" Margin="0 2 0 0" Foreground="{DynamicResource Theme.SecondaryBorder}"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="Day6PlansPanel"/>
                                </ScrollViewer>
                                <Button x:Name="Day6AddPlanButton" Grid.Row="3" Content="➕ Add Plan" Style="{StaticResource GhostButton}" FontSize="10" Height="22" Margin="0 4 0 0" Click="DayAddPlan_Click" Tag="6"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Detailed Plans List -->
            <TabItem Header="📋 All Plans List">
                <Grid Margin="6">
                    <Border Background="{DynamicResource Theme.CardBackground}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <DataGrid x:Name="AllPlansDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding FormattedDate}" Width="100"/>
                                    <DataGridTextColumn Header="Day" Binding="{Binding DayOfWeekName}" Width="95"/>
                                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="160">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="ToolTip" Value="{Binding ProjectName}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Activity" Binding="{Binding Activity}" Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="ToolTip" Value="{Binding Activity}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Planned Hours" Binding="{Binding PlannedHours, StringFormat=\{0:F1\} hrs}" Width="105"/>
                                    <DataGridTextColumn Header="Notes / Description" Binding="{Binding Note}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                <Setter Property="ToolTip" Value="{Binding Note}"/>
                                                <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
                                                <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Action" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="✏ Edit"
                                                            Style="{StaticResource GhostButton}"
                                                            FontSize="10"
                                                            Padding="4 2"
                                                            Margin="2"
                                                            Click="EditPlanItemButton_Click"/>
                                                    <Button Content="🗑 Delete"
                                                            Style="{StaticResource GhostDangerButton}"
                                                            FontSize="10"
                                                            Padding="4 2"
                                                            Margin="2"
                                                            Click="DeletePlanItemButton_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State Overlay (Headers remain visible above) -->
                            <Border x:Name="AllPlansEmptyStatePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0 35 0 0"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                                    <TextBlock Text="📅" FontSize="26" HorizontalAlignment="Center" Margin="0 0 0 6" Opacity="0.6"/>
                                    <TextBlock Text="There are no planned sessions for this week" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Use the schedule form above or quick templates to add a plan" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center" Margin="0 4 0 0" Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 3: Project Goal vs Actual Breakdown -->
            <TabItem Header="🎯 Project Goal Breakdown">
                <Grid Margin="6">
                    <Border Background="{DynamicResource Theme.CardBackground}"
                            BorderBrush="{DynamicResource Theme.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <DataGrid x:Name="ProjectGoalsDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="180"/>
                                    <DataGridTextColumn Header="Planned Goal" Binding="{Binding FormattedPlanned}" Width="110"/>
                                    <DataGridTextColumn Header="Actual Worked" Binding="{Binding FormattedActual}" Width="110"/>
                                    <DataGridTextColumn Header="Variance" Binding="{Binding VarianceHours, StringFormat=\{0:+0.0;-0.0;0.0\} hrs}" Width="95"/>
                                    <DataGridTextColumn Header="Progress (%)" Binding="{Binding FormattedPercentage}" Width="90"/>
                                    <DataGridTemplateColumn Header="Goal Progress Bar" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Value="{Binding CompletionPercentage, Mode=OneWay}" Maximum="100" Height="14" Margin="5 0" Foreground="{DynamicResource Theme.Primary}" Background="{DynamicResource Theme.SecondaryBorder}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State Overlay (Headers remain visible above) -->
                            <Border x:Name="ProjectGoalsEmptyStatePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0 35 0 0"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                                    <TextBlock Text="🎯" FontSize="26" HorizontalAlignment="Center" Margin="0 0 0 6" Opacity="0.6"/>
                                    <TextBlock Text="There are no project goals recorded for this week" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Schedule project hours in the Weekly Board tab to view progress" FontSize="11" Foreground="{DynamicResource Theme.ForegroundMuted}" HorizontalAlignment="Center" Margin="0 4 0 0" Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 3. Bottom Close & Action Bar -->
        <Grid Grid.Row="3" Margin="0 12 0 0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Name="StatusInfoLabel" Text="All changes saved to calendar-plans.json" Foreground="{DynamicResource Theme.ForegroundMuted}" VerticalAlignment="Center" FontSize="11" FontStyle="Italic"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Width="95" Height="30" Click="CloseButton_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
